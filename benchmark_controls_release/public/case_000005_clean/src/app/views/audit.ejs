<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Audit Log — NexusAI</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/nav', { user: user, page: 'admin' }) %>
<main class="content">
<div class="page-header">
  <h1>Audit Log</h1>
  <a href="/admin" class="btn btn-ghost">← Admin</a>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr><th>Time</th><th>User</th><th>Action</th><th>Detail</th><th>IP</th></tr>
    </thead>
    <tbody>
      <% rows.forEach(r => { %>
      <tr>
        <td class="muted"><%= new Date(r.created_at).toLocaleString() %></td>
        <td><%= r.username || '(system)' %></td>
        <td><code><%= r.action %></code></td>
        <td class="muted"><%= r.detail || '—' %></td>
        <td class="muted"><%= r.ip || '—' %></td>
      </tr>
      <% }) %>
      <% if (!rows.length) { %>
      <tr><td colspan="5" class="muted">No audit records yet.</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<div class="pagination">
  <% if (pg > 1) { %><a href="/admin/audit?page=<%= pg-1 %>" class="btn btn-ghost">← Prev</a><% } %>
  <span class="pg-info">Page <%= pg %> of <%= Math.max(1,pgCount) %> (<%= total %> records)</span>
  <% if (pg < pgCount) { %><a href="/admin/audit?page=<%= pg+1 %>" class="btn btn-ghost">Next →</a><% } %>
</div>
</main>
<%- include('partials/footer') %>
</body>
</html>