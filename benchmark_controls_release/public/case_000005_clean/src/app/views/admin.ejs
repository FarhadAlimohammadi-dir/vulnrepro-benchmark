<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin — NexusAI</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/nav', { user: user, page: 'admin' }) %>
<main class="content">
<div class="page-header">
  <h1>Admin Dashboard</h1>
</div>

<div class="stat-grid">
  <div class="stat-card"><div class="stat-num"><%= stats.userCount %></div><div class="stat-label">Users</div></div>
  <div class="stat-card"><div class="stat-num"><%= stats.convoCount %></div><div class="stat-label">Conversations</div></div>
  <div class="stat-card"><div class="stat-num"><%= stats.callCount %></div><div class="stat-label">Calls Placed</div></div>
  <div class="stat-card"><div class="stat-num"><%= stats.notifCount %></div><div class="stat-label">Notifications</div></div>
</div>

<div class="dash-card" style="margin-top:1.5rem">
  <div style="display:flex;justify-content:space-between;align-items:center">
    <h2 class="card-title">Recent Users</h2>
    <a href="/admin/users" class="btn btn-secondary btn-sm">Manage Users</a>
  </div>
  <table class="data-table">
    <thead><tr><th>ID</th><th>Username</th><th>Display Name</th><th>Role</th><th>Email</th><th>Joined</th></tr></thead>
    <tbody>
      <% recentUsers.forEach(u => { %>
      <tr>
        <td class="muted"><%= u.id %></td>
        <td><strong><%= u.username %></strong></td>
        <td><%= u.display_name || '—' %></td>
        <td><span class="badge <%= u.role==='admin'?'badge-purple':'badge-blue' %>"><%= u.role %></span></td>
        <td class="muted"><%= u.email || '—' %></td>
        <td class="muted"><%= new Date(u.created_at).toLocaleDateString() %></td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<div class="dash-card" style="margin-top:1rem">
  <div style="display:flex;justify-content:space-between;align-items:center">
    <h2 class="card-title">Audit Log</h2>
    <a href="/admin/audit" class="btn btn-secondary btn-sm">View All</a>
  </div>
  <p class="muted">Full audit trail available on the audit log page.</p>
</div>
</main>
<%- include('partials/footer') %>
</body>
</html>