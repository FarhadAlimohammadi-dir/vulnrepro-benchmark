<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= contact ? 'Edit Contact' : 'New Contact' %> — NexusAI</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/nav', { user: user, page: 'contacts' }) %>
<main class="content">
<div class="page-header">
  <h1><%= contact && contact.id ? 'Edit Contact' : 'New Contact' %></h1>
  <a href="/contacts" class="btn btn-ghost">← Back</a>
</div>

<% if (error) { %>
<div class="alert alert-error"><%= error %></div>
<% } %>

<div class="form-card">
  <form method="POST" action="/contacts/<%= contact && contact.id ? contact.id + '/edit' : 'new' %>">
    <label class="field-label">Full Name <span class="required">*</span></label>
    <input class="field-input" name="name" value="<%= (contact && contact.name) || '' %>" required maxlength="120">

    <label class="field-label">Phone</label>
    <input class="field-input" name="phone" value="<%= (contact && contact.phone) || '' %>" maxlength="30" placeholder="+1 555 000 0000">

    <label class="field-label">Email</label>
    <input class="field-input" name="email" type="email" value="<%= (contact && contact.email) || '' %>" maxlength="100">

    <label class="field-label">Notes</label>
    <textarea class="field-input" name="notes" rows="3" maxlength="500"><%= (contact && contact.notes) || '' %></textarea>

    <div style="margin-top:1rem">
      <button class="btn btn-primary" type="submit">Save Contact</button>
      <a href="/contacts" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</div>
</main>
<%- include('partials/footer') %>
</body>
</html>