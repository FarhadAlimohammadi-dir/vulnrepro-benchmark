<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'NexusAI' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <a class="brand" href="/dashboard">⬡ NexusAI</a>
  <% if (typeof user !== 'undefined' && user) { %>
  <div class="nav-links">
    <a href="/dashboard" class="<%= page==='dashboard'?'active':'' %>">Home</a>
    <a href="/contacts"  class="<%= page==='contacts' ?'active':'' %>">Contacts</a>
    <a href="/calendar"  class="<%= page==='calendar' ?'active':'' %>">Calendar</a>
    <% if (user.role === 'admin') { %>
    <a href="/admin"     class="<%= page==='admin'    ?'active':'' %>">Admin</a>
    <% } %>
    <a href="/profile"   class="<%= page==='profile'  ?'active':'' %>">Profile</a>
    <a href="/logout" class="btn-logout">Sign out</a>
  </div>
  <% } %>
</nav>
<main class="content">
  <%- body %>
</main>
<footer class="footer">© 2025 NexusAI Platform — <span style="opacity:.5">v2.0</span></footer>
</body>
</html>