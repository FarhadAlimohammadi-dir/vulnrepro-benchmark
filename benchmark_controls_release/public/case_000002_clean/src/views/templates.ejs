<%
  title = 'Templates'
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, ch => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  }[ch]))
  const rows = templates.map(t => `
    <div class="entry">
      <strong>${esc(t.name)}</strong>
      <span class="pill">${esc(t.language || '-')}</span>
      <p class="muted">${esc(t.description || '')}</p>
    </div>
  `).join('')
  body = `
<h1>Project templates</h1>
<p class="muted">Browse curated boilerplates. Start a new project from any template.</p>
${rows || '<p class="muted">No templates defined.</p>'}
`
%>
<%- include('layout', { title, body, user, flash }) %>
