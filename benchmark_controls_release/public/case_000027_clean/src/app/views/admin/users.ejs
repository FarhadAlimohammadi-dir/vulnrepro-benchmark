<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Users — Admin — CodeVault</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
<nav>
  <a href="/" class="brand">⟨/⟩ CodeVault</a>
  <a href="/admin">Admin</a>
  <span class="spacer"></span>
  <% if (locals.currentUser) { %>
    <a href="/profile/<%= currentUser.username %>"><%= currentUser.username %></a>
    <a href="/logout">Logout</a>
  <% } %>
</nav>
<div class="container page">
  <h1 class="mb-2">Users (<%= total %>)</h1>
  <table>
    <thead><tr><th>ID</th><th>Username</th><th>Email</th><th>Role</th><th>Joined</th></tr></thead>
    <tbody>
      <% users.forEach(u => { %>
        <tr>
          <td class="text-muted"><%= u.id %></td>
          <td><a href="/profile/<%= u.username %>"><%= u.username %></a></td>
          <td><%= u.email %></td>
          <td><span class="badge <%= u.role === 'admin' ? 'badge-purple' : '' %>"><%= u.role %></span></td>
          <td class="text-muted"><%= new Date(u.created_at).toLocaleDateString() %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
  <% if (pages > 1) { %>
    <div class="pagination">
      <% for (let i = 1; i <= pages; i++) { %>
        <a href="/admin/users?page=<%= i %>" class="<%= i === page ? 'active' : '' %>"><%= i %></a>
      <% } %>
    </div>
  <% } %>
</div>
</body>
</html>