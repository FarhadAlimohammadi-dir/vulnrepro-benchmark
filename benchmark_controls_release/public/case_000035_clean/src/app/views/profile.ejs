<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body>
  <%
    const profRoles = (user.roles || '').split(',').map(r => r.trim());
    const profIsAdmin = profRoles.some(r => r === 'ADMIN' || r === 'ADMIN AND REQUESTER');
  %>
  <nav class="navbar">
    <div class="nav-brand"><a href="/dashboard">&#9656; Gateway Portal</a></div>
    <ul class="nav-links">
      <li><a href="/dashboard">Dashboard</a></li>
      <li><a href="/requests">My Requests</a></li>
      <li><a href="/profile" class="active">Profile</a></li>
      <% if (profIsAdmin) { %><li><a href="/admin">Admin</a></li><% } %>
    </ul>
    <div class="nav-user">
      <span class="nav-username"><%= user.employee_name %></span>
      <a href="/logout" class="btn-logout">Sign Out</a>
    </div>
  </nav>
  <main class="main-content">
    <div class="page-header">
      <h1>My Profile</h1>
    </div>

    <div class="profile-grid">
      <div class="profile-card">
        <h2>Personal Information</h2>
        <div id="profile-message" class="alert" style="display:none;"></div>
        <form id="profile-form">
          <div class="form-group">
            <label>Full Name</label>
            <input type="text" id="employeeName" name="employeeName" value="<%= user.employee_name %>" required />
          </div>
          <div class="form-group">
            <label>Email Address</label>
            <input type="email" value="<%= user.username %>" disabled />
            <small class="form-hint">Email address cannot be changed.</small>
          </div>
          <div class="form-group">
            <label>Job Title</label>
            <input type="text" id="title" name="title" value="<%= user.title || '' %>" />
          </div>
          <div class="form-group">
            <label>Department</label>
            <select id="department" name="department">
              <% departments.forEach(function(d) { %>
              <option value="<%= d.name %>" <%= user.department === d.name ? 'selected' : '' %>><%= d.name %></option>
              <% }); %>
            </select>
          </div>
          <div class="form-group">
            <label>Phone</label>
            <input type="text" id="phone" name="phone" value="<%= user.phone || '' %>" />
          </div>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </form>
      </div>

      <div class="profile-card">
        <h2>Security</h2>
        <div id="pwd-message" class="alert" style="display:none;"></div>
        <form id="pwd-form">
          <div class="form-group">
            <label>Current Password</label>
            <input type="password" id="currentPassword" name="currentPassword" required />
          </div>
          <div class="form-group">
            <label>New Password</label>
            <input type="password" id="newPassword" name="newPassword" required minlength="8" />
          </div>
          <button type="submit" class="btn btn-outline">Change Password</button>
        </form>

        <hr style="margin: 1.5rem 0;" />
        <h3>Roles &amp; Permissions</h3>
        <div class="roles-list">
          <% profRoles.forEach(function(role) { %>
          <span class="role-badge"><%= role %></span>
          <% }); %>
        </div>
        <p class="form-hint" style="margin-top:0.5rem;">To change your role, submit a request to IT or contact your manager.</p>
      </div>
    </div>
  </main>
  <footer class="site-footer">
    <p>&copy; 2024 Target Corporation</p>
  </footer>
  <script>
    document.getElementById('profile-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const msg = document.getElementById('profile-message');
      const data = {
        employeeName: document.getElementById('employeeName').value,
        title: document.getElementById('title').value,
        department: document.getElementById('department').value,
        phone: document.getElementById('phone').value
      };
      const resp = await fetch('/api/profile/update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await resp.json();
      msg.style.display = 'block';
      msg.className = resp.ok ? 'alert alert-success' : 'alert alert-error';
      msg.textContent = resp.ok ? result.message : result.error;
    });

    document.getElementById('pwd-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const msg = document.getElementById('pwd-message');
      const data = {
        currentPassword: document.getElementById('currentPassword').value,
        newPassword: document.getElementById('newPassword').value
      };
      const resp = await fetch('/api/profile/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await resp.json();
      msg.style.display = 'block';
      msg.className = resp.ok ? 'alert alert-success' : 'alert alert-error';
      msg.textContent = resp.ok ? result.message : result.error;
      if (resp.ok) document.getElementById('pwd-form').reset();
    });
  </script>
</body>
</html>