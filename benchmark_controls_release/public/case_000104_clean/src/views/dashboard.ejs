<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= dashboard.title %> — DataViz Studio</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f5f7fa; }
    nav { background: #1a1a2e; color: white; padding: 0 24px; display: flex; align-items: center; height: 56px; justify-content: space-between; }
    nav .brand { font-weight: 700; }
    nav a { color: #a5b4fc; text-decoration: none; font-size: 0.9rem; margin-left: 16px; }
    .container { max-width: 900px; margin: 0 auto; padding: 32px 24px; }
    .dashboard-header { background: white; border-radius: 8px; padding: 28px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); margin-bottom: 24px; }
    .dashboard-header h1 { font-size: 1.6rem; color: #1a1a2e; margin-bottom: 8px; }
    .dashboard-header .owner { font-size: 0.85rem; color: #888; margin-bottom: 16px; }
    .description-block { font-size: 0.95rem; color: #333; line-height: 1.6; padding: 16px; background: #f9fafb; border-radius: 6px; border-left: 3px solid #4f46e5; }
    .config-block { background: #1e1e2e; color: #cdd6f4; border-radius: 8px; padding: 20px; margin-top: 20px; font-family: 'Courier New', monospace; font-size: 0.85rem; overflow-x: auto; }
    .comments { background: white; border-radius: 8px; padding: 24px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
    .comments h2 { font-size: 1.1rem; margin-bottom: 16px; color: #1a1a2e; }
    .comment { border-bottom: 1px solid #f0f0f0; padding: 12px 0; }
    .comment:last-child { border-bottom: none; }
    .comment .meta { font-size: 0.8rem; color: #888; margin-bottom: 4px; }
    .comment .body { font-size: 0.9rem; color: #333; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 99px; font-size: 0.75rem; font-weight: 600; }
    .badge.public { background: #dcfce7; color: #166534; }
    .badge.private { background: #f3f4f6; color: #6b7280; }
    .actions { margin-top: 16px; display: flex; gap: 10px; }
    .btn { padding: 7px 16px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; text-decoration: none; cursor: pointer; border: none; }
    .btn-edit { background: #f3f4f6; color: #374151; }
    .btn-delete { background: #fef2f2; color: #dc2626; }
  </style>
</head>
<body>
  <nav>
    <span class="brand">📊 DataViz Studio</span>
    <div>
      <a href="/">← Dashboards</a>
      <% if (user) { %>
        <span style="color:#a5b4fc;font-size:0.85rem;margin-left:16px;"><%= user.username %></span>
      <% } %>
    </div>
  </nav>

  <div class="container">
    <div class="dashboard-header">
      <h1><%= dashboard.title %></h1>
      <div class="owner">
        by <strong><%= dashboard.owner_name %></strong> &nbsp;
        <span class="badge <%= dashboard.is_public ? 'public' : 'private' %>"><%= dashboard.is_public ? 'Public' : 'Private' %></span>
      </div>

      <%# legacy: kept for v1 API clients still in the wild — description supports rich annotations %>
      <div class="description-block"><%= dashboard.description %></div>

      <div class="config-block"><%= dashboard.chart_config %></div>

      <% if (user && user.id === dashboard.user_id) { %>
        <div class="actions">
          <a href="/dashboards/<%= dashboard.id %>/edit" class="btn btn-edit">Edit</a>
          <form method="POST" action="/dashboards/<%= dashboard.id %>/delete" style="display:inline;">
            <button type="submit" class="btn btn-delete" onclick="return confirm('Delete this dashboard?')">Delete</button>
          </form>
        </div>
      <% } %>
    </div>

    <div class="comments">
      <h2>Comments (<%= comments.length %>)</h2>
      <% if (comments.length === 0) { %>
        <p style="color:#999;font-size:0.9rem;">No comments yet.</p>
      <% } else { %>
        <% comments.forEach(function(c) { %>
          <div class="comment">
            <div class="meta"><strong><%= c.username %></strong> &middot; <%= new Date(c.created_at).toLocaleDateString() %></div>
            <div class="body"><%= c.body %></div>
          </div>
        <% }); %>
      <% } %>
    </div>
  </div>
</body>
</html>
