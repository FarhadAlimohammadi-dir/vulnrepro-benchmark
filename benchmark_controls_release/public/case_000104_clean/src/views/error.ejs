<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Error — DataViz Studio</title>
  <style>
    body { font-family: sans-serif; background: #f5f7fa; display: flex; align-items: center; justify-content: center; min-height: 100vh; }
    .card { background: white; padding: 40px; border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,0.1); text-align: center; max-width: 400px; }
    h1 { color: #dc2626; margin-bottom: 12px; }
    p { color: #555; margin-bottom: 20px; }
    a { color: #4f46e5; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Error</h1>
    <p><%= message %></p>
    <a href="/">← Back to Dashboards</a>
  </div>
</body>
</html>