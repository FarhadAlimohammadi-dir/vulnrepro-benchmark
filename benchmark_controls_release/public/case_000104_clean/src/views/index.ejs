<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>DataViz Studio — Dashboards</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f5f7fa; }
    nav { background: #1a1a2e; color: white; padding: 0 24px; display: flex; align-items: center; justify-content: space-between; height: 56px; }
    nav .brand { font-weight: 700; font-size: 1.1rem; }
    nav a { color: #a5b4fc; text-decoration: none; font-size: 0.9rem; margin-left: 20px; }
    nav a:hover { color: white; }
    .container { max-width: 1100px; margin: 0 auto; padding: 32px 24px; }
    .page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; }
    h2 { font-size: 1.5rem; color: #1a1a2e; }
    .btn-primary { background: #4f46e5; color: white; padding: 8px 18px; border-radius: 6px; text-decoration: none; font-size: 0.9rem; font-weight: 600; }
    .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; }
    .card { background: white; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); padding: 20px; }
    .card h3 { font-size: 1rem; margin-bottom: 6px; }
    .card h3 a { color: #1a1a2e; text-decoration: none; }
    .card h3 a:hover { color: #4f46e5; }
    .card .meta { font-size: 0.8rem; color: #888; margin-top: 10px; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 99px; font-size: 0.75rem; font-weight: 600; }
    .badge.public { background: #dcfce7; color: #166534; }
    .badge.private { background: #f3f4f6; color: #6b7280; }
    .empty { text-align: center; padding: 60px; color: #999; }
  </style>
</head>
<body>
  <nav>
    <span class="brand">📊 DataViz Studio</span>
    <div>
      <span style="color:#a5b4fc;font-size:0.85rem;">Logged in as <strong><%= user.username %></strong></span>
      <a href="/dashboards/new">+ New Dashboard</a>
      <form method="POST" action="/auth/logout" style="display:inline;">
        <button type="submit" style="background:none;border:none;color:#a5b4fc;cursor:pointer;font-size:0.9rem;margin-left:20px;">Logout</button>
      </form>
    </div>
  </nav>
  <div class="container">
    <div class="page-header">
      <h2>Your Dashboards</h2>
      <a href="/dashboards/new" class="btn-primary">+ New Dashboard</a>
    </div>
    <% if (dashboards.length === 0) { %>
      <div class="empty">No dashboards yet. <a href="/dashboards/new">Create one!</a></div>
    <% } else { %>
      <div class="grid">
        <% dashboards.forEach(function(d) { %>
          <div class="card">
            <h3><a href="/dashboards/<%= d.id %>"><%= d.title %></a></h3>
            <p style="font-size:0.85rem;color:#555;margin-top:4px;"><%= d.owner %></p>
            <div class="meta">
              <span class="badge <%= d.is_public ? 'public' : 'private' %>"><%= d.is_public ? 'Public' : 'Private' %></span>
              &nbsp;Created <%= new Date(d.created_at).toLocaleDateString() %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</body>
</html>