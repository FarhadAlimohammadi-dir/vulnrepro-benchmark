<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Trust Policy — IAM Policy Studio</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/dashboard">🔐 IAM Policy Studio</a></div>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/policies" class="active">Policies</a>
      <div class="nav-user">
        <span class="nav-username">👤 <%= user %></span>
        <a href="/profile">Profile</a>
        <a href="/logout">Logout</a>
      </div>
    </div>
  </nav>

  <main class="main-content">
    <div class="page-header">
      <a href="/policies" class="breadcrumb">← Policies</a>
      <h1>New Trust Policy</h1>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="card" style="max-width: 800px;">
      <form method="POST" action="/policies/new">
        <div class="form-group">
          <label for="name">Policy Name *</label>
          <input type="text" id="name" name="name" placeholder="github-actions-myteam-prod" required>
        </div>
        <div class="form-group">
          <label for="description">Description</label>
          <textarea id="description" name="description" rows="2" placeholder="Describe the purpose of this policy..."></textarea>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="provider">Provider</label>
            <select id="provider" name="provider">
              <option value="github-actions">GitHub Actions</option>
              <option value="terraform-cloud">Terraform Cloud</option>
              <option value="gitlab">GitLab CI</option>
              <option value="circleci">CircleCI</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="form-group">
            <label for="environment">Environment</label>
            <select id="environment" name="environment">
              <option value="production">Production</option>
              <option value="staging">Staging</option>
              <option value="development">Development</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="roleArn">IAM Role ARN</label>
          <input type="text" id="roleArn" name="roleArn" placeholder="arn:aws:iam::123456789012:role/MyRole">
        </div>
        <div class="form-group">
          <label for="trustPolicyJson">Trust Policy JSON *</label>
          <textarea id="trustPolicyJson" name="trustPolicyJson" rows="16" class="mono" placeholder='{"Effect": "Allow", ...}' required></textarea>
          <small>Paste your full IAM trust policy statement including Condition block.</small>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Create Policy</button>
          <a href="/policies" class="btn btn-outline">Cancel</a>
        </div>
      </form>
    </div>
  </main>

  <footer class="footer">
    <p>&copy; 2024 IAM Policy Studio</p>
  </footer>
</body>
</html>