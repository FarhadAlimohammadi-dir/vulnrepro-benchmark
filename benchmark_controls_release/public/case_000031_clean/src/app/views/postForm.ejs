<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title><%= post ? 'Edit Post' : 'New Post' %> — SocialKit</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<header class="site-header">
  <div class="container">
    <a class="logo" href="/">SocialKit</a>
    <nav class="main-nav">
      <a href="/dashboard">Dashboard</a>
      <a href="/logout" class="nav-logout">Sign out</a>
    </nav>
  </div>
</header>
<main class="main-content">
<div class="container">
  <div class="form-card">
    <h2><%= post ? 'Edit Post' : 'Create New Post' %></h2>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="POST" action="<%= post ? '/posts/' + post.id + '/update' : '/posts' %>">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= post ? post.title : '' %>" required placeholder="Post title">
      </div>
      <div class="form-group">
        <label for="body">Content</label>
        <textarea id="body" name="body" rows="8" required placeholder="Write your content…"><%= post ? post.body : '' %></textarea>
      </div>
      <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="published" <%= (!post || post.status === 'published') ? 'selected' : '' %>>Published</option>
          <option value="draft" <%= (post && post.status === 'draft') ? 'selected' : '' %>>Draft</option>
        </select>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= post ? 'Save Changes' : 'Publish' %></button>
        <a href="/dashboard" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </div>
</div>
</main>
<footer class="site-footer"><div class="container"><p>&copy; 2024 SocialKit Platform</p></div></footer>
</body>
</html>