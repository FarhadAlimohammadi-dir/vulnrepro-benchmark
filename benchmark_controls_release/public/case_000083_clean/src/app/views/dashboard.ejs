<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Dashboard — MarketHub</title>
  <link rel="stylesheet" href="/styles/main.css">
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/">MarketHub</a>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/logout">Sign out (<%= username %>)</a>
    </div>
  </nav>

  <main class="container">
    <h2>Dashboard</h2>

    <% if (isPro) { %>
      <section class="card">
        <h3>Upload a File</h3>
        <p class="hint">Upload JSON content for your marketplace listings. Max 1 MB per file.</p>
        <label for="filename">Filename</label>
        <input id="filename" type="text" placeholder="e.g. listing-data.json" />
        <label for="content">Content (JSON)</label>
        <textarea id="content" rows="8" placeholder='{"title":"My Listing","description":"..."}'></textarea>
        <button class="btn btn-primary" onclick="uploadFile()">Upload</button>
        <p id="upload-msg" class="hint"></p>
      </section>

      <section class="card">
        <h3>Your Files</h3>
        <% if (files.length === 0) { %>
          <p>No files uploaded yet.</p>
        <% } else { %>
          <table class="data-table">
            <thead><tr><th>Filename</th><th>File ID</th><th>Actions</th></tr></thead>
            <tbody>
              <% files.forEach(f => { %>
                <tr>
                  <td><%= f.filename %></td>
                  <td><code><%= f.file_id %></code></td>
                  <td><a href="/api/marketplace/files/<%= f.file_id %>">View</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </section>
    <% } else { %>
      <section class="card">
        <p>Upgrade to <strong>Pro</strong> to unlock file uploads and advanced listing tools.</p>
      </section>
    <% } %>

    <section class="card">
      <h3>Recent Activity</h3>
      <% if (recentActivity.length === 0) { %>
        <p>No activity recorded yet.</p>
      <% } else { %>
        <ul class="activity-list">
          <% recentActivity.forEach(entry => { %>
            <li><strong><%= entry.action %></strong> — <%= new Date(entry.created_at * 1000).toLocaleString() %></li>
          <% }); %>
        </ul>
      <% } %>
    </section>
  </main>

  <script>
    function uploadFile() {
      const filename = document.getElementById('filename').value.trim();
      const content  = document.getElementById('content').value.trim();
      const msg      = document.getElementById('upload-msg');

      if (!filename || !content) {
        msg.textContent = 'Please fill in both fields.';
        return;
      }

      fetch('/api/marketplace/files', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ filename, content })
      })
      .then(r => r.json())
      .then(data => {
        if (data.fileId) {
          msg.textContent = 'Uploaded successfully. File ID: ' + data.fileId;
          setTimeout(() => location.reload(), 1500);
        } else {
          msg.textContent = data.error || 'Upload failed.';
        }
      })
      .catch(() => { msg.textContent = 'Network error during upload.'; });
    }
  </script>
</body>
</html>