<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CloudVault — <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Storage Manager' %></title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/dashboard" class="logo">☁ CloudVault</a>
      <nav class="main-nav">
        <% if (currentUser) { %>
          <a href="/dashboard">Dashboard</a>
          <a href="/buckets">Buckets</a>
          <a href="/search">Search</a>
          <% if (currentUser.role === 'admin') { %>
            <a href="/admin">Admin</a>
          <% } %>
          <a href="/profile">Profile</a>
          <form method="POST" action="/logout" style="display:inline">
            <button type="submit" class="btn-link">Sign Out</button>
          </form>
        <% } else { %>
          <a href="/">Sign In</a>
        <% } %>
      </nav>
    </div>
  </header>
  <main class="container">
    <%- body %>
  </main>
  <footer class="site-footer">
    <div class="container">
      <span>CloudVault Storage Manager v2.1.0</span>
      <span>© 2024 CloudVault Inc.</span>
    </div>
  </footer>
</body>
</html>