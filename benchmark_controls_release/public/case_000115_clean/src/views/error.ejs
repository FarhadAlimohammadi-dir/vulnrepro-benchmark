<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Error - API Docs Portal</title>
  <style>
    body { font-family: -apple-system, sans-serif; display: flex; align-items: center; justify-content: center; min-height: 100vh; background: #f0f2f5; }
    .card { background: white; border-radius: 8px; padding: 40px; text-align: center; box-shadow: 0 2px 16px rgba(0,0,0,0.1); }
    h1 { color: #dc2626; margin-bottom: 12px; }
    a { color: #4f46e5; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Error</h1>
    <p><%= message %></p>
    <p><a href="/docs">← Back to docs</a></p>
  </div>
</body>
</html>