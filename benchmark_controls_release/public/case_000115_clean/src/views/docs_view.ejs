<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= spec.title %> - API Docs Portal</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f0f2f5; }
    .navbar { background: #1a1a2e; color: white; padding: 0 24px; height: 56px; display: flex; align-items: center; justify-content: space-between; }
    .navbar h1 { font-size: 1.1rem; }
    .navbar a { color: #a5b4fc; text-decoration: none; font-size: 0.9rem; }
    .container { max-width: 1000px; margin: 32px auto; padding: 0 24px; }
    .spec-doc { background: white; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.08); padding: 32px; }
    .spec-title { font-size: 2rem; font-weight: 700; color: #1a1a2e; }
    .spec-version { font-size: 0.9rem; color: #6b7280; margin-left: 12px; }
    .spec-description { margin: 16px 0; color: #374151; line-height: 1.6; }
    .operation { border: 1px solid #e5e7eb; border-radius: 6px; margin: 16px 0; overflow: hidden; }
    .operation-header { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: #f9fafb; }
    .http-method { padding: 3px 10px; border-radius: 4px; font-size: 0.8rem; font-weight: 700; text-transform: uppercase; }
    .get { background: #dbeafe; color: #1e40af; }
    .post { background: #d1fae5; color: #065f46; }
    .put { background: #fef3c7; color: #92400e; }
    .patch { background: #ede9fe; color: #5b21b6; }
    .delete { background: #fee2e2; color: #991b1b; }
    .operation-path { font-family: monospace; font-size: 0.95rem; font-weight: 600; }
    .operation-summary { color: #6b7280; font-size: 0.9rem; }
    .operation-description, .operation-params { padding: 16px; }
    .param-widget { border-top: 1px solid #f3f4f6; padding: 12px 16px; }
    .param-header { display: flex; gap: 8px; align-items: center; margin-bottom: 4px; }
    .param-name { font-family: monospace; font-weight: 600; color: #1a1a2e; }
    .param-in { font-size: 0.8rem; color: #6b7280; }
    .param-type { font-size: 0.8rem; background: #f3f4f6; padding: 1px 6px; border-radius: 3px; color: #374151; }
    .param-required { font-size: 0.75rem; color: #dc2626; font-weight: 600; }
    .param-input { width: 100%; padding: 6px 10px; border: 1px solid #d1d5db; border-radius: 4px; font-size: 0.875rem; margin-top: 6px; }
    .tag { display: inline-block; background: #ede9fe; color: #5b21b6; padding: 2px 8px; border-radius: 12px; font-size: 0.75rem; }
    .back-link { display: inline-block; margin-bottom: 20px; color: #4f46e5; text-decoration: none; font-size: 0.9rem; }
    .back-link:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <nav class="navbar">
    <h1>📚 API Docs Portal</h1>
    <a href="/auth/logout">Sign out (<%= user ? user.username : '' %>)</a>
  </nav>
  <div class="container">
    <a href="/docs" class="back-link">← Back to all specs</a>
    <div class="spec-doc">
      <%- renderedHtml %>
    </div>
  </div>
</body>
</html>