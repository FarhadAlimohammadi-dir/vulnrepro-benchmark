<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'CodeFlow' %> — CodeFlow OAuth</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">
      <a href="/">&#128279; CodeFlow</a>
    </div>
    <div class="nav-links">
      <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Home</a>
      <a href="/oauth/clients" class="<%= page === 'clients' ? 'active' : '' %>">Applications</a>
      <% if (user) { %>
        <a href="/profile" class="<%= page === 'profile' ? 'active' : '' %>">Profile</a>
        <% if (typeof userRole !== 'undefined' && userRole === 'admin') { %>
          <a href="/admin" class="<%= page === 'admin' ? 'active' : '' %>">Admin</a>
        <% } %>
        <form action="/logout" method="post" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="nav-logout" type="submit">Logout (<%= user %>)</button></form>
      <% } else { %>
        <a href="/login" class="<%= page === 'login' ? 'active' : '' %>">Login</a>
      <% } %>
    </div>
  </nav>
  <main class="container">
    <%- body %>
  </main>
  <footer class="footer">
    <p>&copy; 2024 CodeFlow OAuth Platform &mdash; v2.1.0</p>
  </footer>
</body>
</html>