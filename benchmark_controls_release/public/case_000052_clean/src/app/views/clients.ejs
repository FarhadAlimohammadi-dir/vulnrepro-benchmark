<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Applications — CodeFlow OAuth</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/">&#128279; CodeFlow</a></div>
    <div class="nav-links">
      <a href="/">Home</a>
      <a href="/oauth/clients" class="active">Applications</a>
      <% if (user) { %>
        <a href="/profile">Profile</a>
        <form action="/logout" method="post" style="display:inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="nav-logout" type="submit">Logout (<%= user %>)</button></form>
      <% } else { %>
        <a href="/login">Login</a>
      <% } %>
    </div>
  </nav>
  <main class="container">
    <h1>&#128196; Registered Applications</h1>
    <p class="muted">OAuth 2.0 clients registered on this authorization server.</p>

    <div class="table-container">
      <table class="data-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Client ID</th>
            <th>Owner</th>
            <th>Scopes</th>
            <th>Website</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% for (const c of clients) { %>
            <tr>
              <td><strong><%= c.name %></strong></td>
              <td><code><%= c.id %></code></td>
              <td><%= c.owner_name || '—' %></td>
              <td>
                <% for (const scope of (c.scopes || '').split(' ')) { %>
                  <span class="badge"><%= scope %></span>
                <% } %>
              </td>
              <td>
                <% if (c.website) { %>
                  <a href="<%= c.website %>" target="_blank" rel="noopener">&#128279;</a>
                <% } else { %>
                  —
                <% } %>
              </td>
              <td><a href="/oauth/clients/<%= c.id %>" class="btn btn-sm">Details</a></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
  <footer class="footer">
    <p>&copy; 2024 CodeFlow OAuth Platform</p>
  </footer>
</body>
</html>