<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Settings — VisionBoard</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<nav class="navbar">
  <a class="navbar-brand" href="/"><span class="brand-icon">◈</span> VisionBoard</a>
  <div class="navbar-links">
    <a href="/gallery">Gallery</a>
    <a href="/dashboard">My Images</a>
    <a href="/settings" class="active">Settings</a>
    <% if (isAdmin) { %><a href="/admin">Admin</a><% } %>
    <span class="nav-user">@<%= currentUser.username %></span>
    <form method="POST" action="/logout" style="display:inline">
      <button class="btn btn-ghost btn-sm">Sign out</button>
    </form>
  </div>
</nav>
<main class="container" style="max-width:600px">
  <h2>Account Settings</h2>

  <% if (saved) { %>
    <div class="alert alert-success">Your profile has been updated.</div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <div class="card">
    <h3>Profile</h3>
    <form method="POST" action="/settings">
      <div class="form-group">
        <label>Username</label>
        <input type="text" value="@<%= user.username %>" disabled>
      </div>
      <div class="form-group">
        <label>Full Name</label>
        <input name="full_name" type="text" value="<%= user.full_name || '' %>" placeholder="Your full name">
      </div>
      <div class="form-group">
        <label>Email</label>
        <input name="email" type="email" value="<%= user.email || '' %>" placeholder="you@example.com">
      </div>
      <div class="form-group">
        <label>Bio</label>
        <textarea name="bio" rows="3" placeholder="Tell us about yourself…"><%= user.bio || '' %></textarea>
      </div>
      <button class="btn btn-primary" type="submit">Save changes</button>
    </form>
  </div>

  <div class="card" style="margin-top:1.5rem">
    <h3>Subscription</h3>
    <p>Current plan: <span class="plan-badge plan-<%= user.plan %>"><%= user.plan %></span></p>
    <% if (user.plan === 'free') { %>
      <p>Upgrade to <strong>Pro</strong> for higher upload limits and priority analysis.</p>
      <a href="#" class="btn btn-primary">Upgrade to Pro</a>
    <% } else { %>
      <p>Thank you for being a <strong><%= user.plan %></strong> subscriber!</p>
    <% } %>
  </div>
</main>
<footer class="site-footer"><p>© 2024 VisionBoard</p></footer>
</body>
</html>