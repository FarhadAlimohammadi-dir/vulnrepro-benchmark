<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign In — VisionBoard</title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body class="auth-page">
<div class="auth-card">
  <div class="auth-logo">
    <span class="brand-icon-lg">◈</span>
    <h1>VisionBoard</h1>
    <p class="auth-tagline">AI-powered image analysis for teams</p>
  </div>
  <% if (typeof info !== 'undefined' && info) { %>
    <div class="alert alert-success"><%= info %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>
  <form method="POST" action="/login" class="auth-form">
    <div class="form-group">
      <label for="username">Username</label>
      <input id="username" name="username" type="text" autocomplete="username" required placeholder="your_username">
    </div>
    <div class="form-group">
      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required placeholder="••••••••">
    </div>
    <button type="submit" class="btn btn-primary btn-full">Sign in</button>
  </form>
  <p class="auth-footer">Don't have an account? <a href="/register">Create one</a></p>
</div>
</body>
</html>