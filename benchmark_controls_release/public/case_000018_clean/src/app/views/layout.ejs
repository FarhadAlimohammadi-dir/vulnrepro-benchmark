<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — VisionBoard' : 'VisionBoard' %></title>
  <link rel="stylesheet" href="/static/style.css">
</head>
<body>
<nav class="navbar">
  <a class="navbar-brand" href="/">
    <span class="brand-icon">◈</span> VisionBoard
  </a>
  <div class="navbar-links">
    <a href="/gallery">Gallery</a>
    <% if (currentUser) { %>
      <a href="/dashboard">My Images</a>
      <a href="/settings">Settings</a>
      <% if (isAdmin) { %><a href="/admin">Admin</a><% } %>
      <span class="nav-user">@<%= currentUser.username %></span>
      <form method="POST" action="/logout" style="display:inline">
        <button class="btn btn-ghost btn-sm">Sign out</button>
      </form>
    <% } else { %>
      <a href="/login">Sign in</a>
      <a href="/register" class="btn btn-primary btn-sm">Get started</a>
    <% } %>
  </div>
</nav>
<main class="container">
  <%- body %>
</main>
<footer class="site-footer">
  <p>© 2024 VisionBoard. AI-powered image analysis.</p>
</footer>
</body>
</html>