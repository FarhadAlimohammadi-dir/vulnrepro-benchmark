<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>DevForge – Admin</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/dashboard">⚙ DevForge</a>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/projects">Projects</a>
      <a href="/admin">Admin</a>
      <a href="/profile">👤 <%= currentUser ? currentUser.username : '' %></a>
      <a href="/logout">Logout</a>
    </div>
  </nav>
  <main class="container">
    <h1>Admin Overview</h1>
    <div class="stats-row">
      <div class="stat-card"><div class="stat-value"><%= userCount %></div><div class="stat-label">Users</div></div>
      <div class="stat-card"><div class="stat-value"><%= projectCount %></div><div class="stat-label">Projects</div></div>
      <div class="stat-card"><div class="stat-value"><%= taskCount %></div><div class="stat-label">Tasks Executed</div></div>
    </div>
    <div style="margin-top:1rem">
      <a href="/admin/users" class="btn">Manage Users</a>
      <a href="/admin/audit" class="btn" style="margin-left:.5rem">Audit Log</a>
    </div>
    <div class="section">
      <h2>Recent Activity</h2>
      <table class="data-table">
        <thead><tr><th>Actor</th><th>Action</th><th>Target</th><th>IP</th><th>When</th></tr></thead>
        <tbody>
        <% recentEvents.forEach(e => { %>
          <tr>
            <td><%= e.actor_name %></td>
            <td><code><%= e.action %></code></td>
            <td class="muted"><%= e.target || '—' %></td>
            <td class="muted"><%= e.ip || '—' %></td>
            <td class="muted"><%= new Date(e.created_at).toLocaleString() %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </main>
  <footer class="footer">DevForge v2.0 &copy; 2024</footer>
</body>
</html>