<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>DevForge – Add Snippet</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/dashboard">⚙ DevForge</a>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/projects">Projects</a>
      <a href="/profile">👤 <%= currentUser ? currentUser.username : '' %></a>
      <a href="/logout">Logout</a>
    </div>
  </nav>
  <main class="container" style="max-width:700px">
    <h1>Add Snippet to <em><%= project.name %></em></h1>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="POST" action="/projects/<%= project.id %>/snippets">
      <div class="form-group">
        <label>Title</label>
        <input name="title" type="text" required maxlength="120">
      </div>
      <div class="form-group">
        <label>Language</label>
        <select name="lang">
          <% langs.forEach(l => { %><option value="<%= l %>"><%= l %></option><% }) %>
        </select>
      </div>
      <div class="form-group">
        <label>Code</label>
        <textarea name="body" rows="12" style="font-family:monospace" required></textarea>
      </div>
      <div style="display:flex;gap:.8rem">
        <button type="submit" class="btn btn-primary">Add Snippet</button>
        <a href="/projects/<%= project.id %>" class="btn">Cancel</a>
      </div>
    </form>
  </main>
  <footer class="footer">DevForge v2.0 &copy; 2024</footer>
</body>
</html>