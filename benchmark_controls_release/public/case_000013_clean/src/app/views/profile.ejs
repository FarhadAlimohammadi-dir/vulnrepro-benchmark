<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>DevForge – Profile</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/dashboard">⚙ DevForge</a>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/projects">Projects</a>
      <% if (currentUser && currentUser.role === 'admin') { %><a href="/admin">Admin</a><% } %>
      <a href="/profile">👤 <%= currentUser ? currentUser.username : '' %></a>
      <a href="/logout">Logout</a>
    </div>
  </nav>
  <main class="container" style="max-width:600px">
    <h1>Profile</h1>
    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
    <% } %>
    <div class="stat-card" style="margin-bottom:1.2rem">
      <p><strong>Username:</strong> <%= profileUser.username %></p>
      <p><strong>Role:</strong> <span class="badge"><%= profileUser.role %></span></p>
      <p><strong>Member since:</strong> <%= new Date(profileUser.created_at).toLocaleDateString() %></p>
      <p><strong>Tasks run:</strong> <%= taskCount %></p>
    </div>
    <form method="POST" action="/profile">
      <div class="form-group">
        <label>Display Name</label>
        <input name="display_name" type="text" value="<%= profileUser.display_name || '' %>">
      </div>
      <div class="form-group">
        <label>Email</label>
        <input name="email" type="email" value="<%= profileUser.email || '' %>">
      </div>
      <button type="submit" class="btn btn-primary">Save Profile</button>
    </form>
  </main>
  <footer class="footer">DevForge v2.0 &copy; 2024</footer>
</body>
</html>