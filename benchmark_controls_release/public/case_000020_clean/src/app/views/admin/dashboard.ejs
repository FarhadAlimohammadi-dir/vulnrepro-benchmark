<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>ToolBridge – Admin</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/dashboard">ToolBridge</a></div>
    <ul class="nav-links">
      <li><a href="/dashboard">Dashboard</a></li>
      <li><a href="/admin" class="active">Admin</a></li>
      <li><a href="/admin/users">Users</a></li>
      <li><a href="/admin/audit">Audit Log</a></li>
      <li><a href="/admin/integrations">All Integrations</a></li>
      <li><a href="/logout">Logout</a></li>
    </ul>
  </nav>
  <main class="main-content">
    <h1>Admin Overview</h1>
    <div class="stats-row">
      <div class="stat-card">
        <div class="stat-number"><%= stats.userCount %></div>
        <div class="stat-label">Users</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= stats.integrationCount %></div>
        <div class="stat-label">Integrations</div>
      </div>
      <div class="stat-card">
        <div class="stat-number"><%= stats.auditCount %></div>
        <div class="stat-label">Audit Events</div>
      </div>
    </div>

    <div class="section">
      <h2>Recent Users</h2>
      <table class="data-table">
        <thead><tr><th>ID</th><th>Username</th><th>Email</th><th>Role</th><th>Joined</th></tr></thead>
        <tbody>
          <% recentUsers.forEach(function(u) { %>
          <tr>
            <td><%= u.id %></td>
            <td><%= u.username %></td>
            <td><%= u.email || '—' %></td>
            <td><span class="badge"><%= u.role %></span></td>
            <td><%= new Date(u.created_at).toLocaleDateString() %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
  <footer class="site-footer"><p>&copy; 2024 ToolBridge, Inc.</p></footer>
</body>
</html>