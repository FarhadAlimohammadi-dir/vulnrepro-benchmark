<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>ToolBridge – Users</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/dashboard">ToolBridge</a></div>
    <ul class="nav-links">
      <li><a href="/dashboard">Dashboard</a></li>
      <li><a href="/admin">Admin</a></li>
      <li><a href="/admin/users" class="active">Users</a></li>
      <li><a href="/logout">Logout</a></li>
    </ul>
  </nav>
  <main class="main-content">
    <div class="page-header">
      <h1>All Users</h1>
      <span class="muted"><%= total %> total</span>
    </div>
    <table class="data-table">
      <thead><tr><th>ID</th><th>Username</th><th>Email</th><th>Role</th><th>Joined</th></tr></thead>
      <tbody>
        <% users.forEach(function(u) { %>
        <tr>
          <td><%= u.id %></td>
          <td><%= u.username %></td>
          <td><%= u.email || '—' %></td>
          <td><span class="badge"><%= u.role %></span></td>
          <td><%= new Date(u.created_at).toLocaleDateString() %></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <div class="pagination">
      <% if (page > 1) { %><a href="/admin/users?page=<%= page - 1 %>" class="btn btn-sm btn-ghost">&larr; Prev</a><% } %>
      <span class="page-info">Page <%= page %> of <%= totalPages %></span>
      <% if (page < totalPages) { %><a href="/admin/users?page=<%= page + 1 %>" class="btn btn-sm btn-ghost">Next &rarr;</a><% } %>
    </div>
  </main>
  <footer class="site-footer"><p>&copy; 2024 ToolBridge, Inc.</p></footer>
</body>
</html>