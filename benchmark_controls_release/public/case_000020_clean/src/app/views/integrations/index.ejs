<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>ToolBridge – Integrations</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/dashboard">ToolBridge</a></div>
    <ul class="nav-links">
      <li><a href="/dashboard">Dashboard</a></li>
      <li><a href="/integrations" class="active">Integrations</a></li>
      <li><a href="/profile">Profile</a></li>
      <li><a href="/logout">Logout</a></li>
    </ul>
  </nav>
  <main class="main-content">
    <div class="page-header">
      <h1><%= title %></h1>
      <a href="/integrations/custom/new" class="btn btn-primary">+ Add Custom Integration</a>
    </div>

    <form method="GET" action="/integrations/search" class="search-form">
      <input name="q" value="<%= search %>" placeholder="Search integrations…" class="input-search" />
      <button type="submit" class="btn btn-outline">Search</button>
    </form>

    <% if (integrations.length === 0) { %>
      <div class="empty-state">
        <p>No integrations found.</p>
        <a href="/integrations/custom/new" class="btn btn-primary">Create your first integration</a>
      </div>
    <% } else { %>
      <table class="data-table">
        <thead>
          <tr><th>Name</th><th>Description</th><th>Type</th><th>Status</th><th>Scopes</th><th>Created</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% integrations.forEach(function(i) { %>
          <tr>
            <td><strong><%= i.name %></strong></td>
            <td class="muted"><%= i.description || '—' %></td>
            <td><span class="badge"><%= i.provider_type %></span></td>
            <td><span class="badge badge-status-<%= i.status %>"><%= i.status %></span></td>
            <td class="muted small"><%= i.scopes || '—' %></td>
            <td><%= new Date(i.created_at).toLocaleDateString() %></td>
            <td class="action-cell">
              <% if (i.provider_type === 'custom') { %>
                <a href="/integrations/custom/<%= i.id %>/connect" class="btn btn-sm btn-outline">Connect</a>
                <a href="/integrations/custom/<%= i.id %>/edit" class="btn btn-sm btn-ghost">Edit</a>
                <form method="POST" action="/integrations/custom/<%= i.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this integration?')">
                  <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                </form>
              <% } else { %>
                <a href="/integrations/<%= i.provider_type %>/connect" class="btn btn-sm btn-outline">Connect</a>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>

      <div class="pagination">
        <% if (page > 1) { %><a href="/integrations?page=<%= page - 1 %>" class="btn btn-sm btn-ghost">&larr; Prev</a><% } %>
        <span class="page-info">Page <%= page %> of <%= totalPages %> &mdash; <%= total %> total</span>
        <% if (page < totalPages) { %><a href="/integrations?page=<%= page + 1 %>" class="btn btn-sm btn-ghost">Next &rarr;</a><% } %>
      </div>
    <% } %>
  </main>
  <footer class="site-footer"><p>&copy; 2024 ToolBridge, Inc.</p></footer>
</body>
</html>