<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>ToolBridge – <%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/dashboard">ToolBridge</a></div>
    <ul class="nav-links">
      <li><a href="/dashboard">Dashboard</a></li>
      <li><a href="/integrations">Integrations</a></li>
      <li><a href="/logout">Logout</a></li>
    </ul>
  </nav>
  <main class="main-content">
    <div class="page-header">
      <h1><%= title %></h1>
      <a href="/integrations" class="btn btn-ghost">&larr; Back</a>
    </div>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="form-card">
      <form method="POST" action="<%= action %>" class="form-stack">
        <div class="form-group">
          <label for="name">Integration Name <span class="required">*</span></label>
          <input id="name" name="name" type="text" value="<%= integration.name || '' %>" placeholder="e.g. My JIRA Cloud" required maxlength="120" />
        </div>
        <div class="form-group">
          <label for="description">Description</label>
          <input id="description" name="description" type="text" value="<%= integration.description || '' %>" placeholder="Brief description of this integration" maxlength="255" />
        </div>
        <div class="form-group">
          <label for="authorization_url">Authorization URL <span class="required">*</span></label>
          <input id="authorization_url" name="authorization_url" type="text" value="<%= integration.authorization_url || '' %>" placeholder="https://provider.example.com/oauth/authorize" required />
          <span class="hint">The OAuth 2.0 authorization endpoint for this provider.</span>
        </div>
        <div class="form-group">
          <label for="token_url">Token URL <span class="required">*</span></label>
          <input id="token_url" name="token_url" type="text" value="<%= integration.token_url || '' %>" placeholder="https://provider.example.com/oauth/token" required />
        </div>
        <div class="form-group">
          <label for="client_id">Client ID <span class="required">*</span></label>
          <input id="client_id" name="client_id" type="text" value="<%= integration.client_id || '' %>" placeholder="your-oauth-client-id" required />
        </div>
        <div class="form-group">
          <label for="scopes">Scopes</label>
          <input id="scopes" name="scopes" type="text" value="<%= integration.scopes || '' %>" placeholder="read write" />
          <span class="hint">Space-separated list of OAuth scopes to request.</span>
        </div>
        <% if (integration.id) { %>
        <div class="form-group">
          <label for="status">Status</label>
          <select id="status" name="status">
            <option value="active" <%= integration.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= integration.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
          </select>
        </div>
        <% } %>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save Integration</button>
          <a href="/integrations" class="btn btn-ghost">Cancel</a>
        </div>
      </form>
    </div>
  </main>
  <footer class="site-footer"><p>&copy; 2024 ToolBridge, Inc.</p></footer>
</body>
</html>