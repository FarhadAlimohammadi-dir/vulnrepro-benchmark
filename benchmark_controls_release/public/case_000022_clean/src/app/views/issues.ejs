<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>CodePilot – Issues</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/nav') %>
<div class="container">
  <div class="section-header">
    <h1 class="page-title">Issues</h1>
  </div>

  <form class="filter-bar" method="GET" action="/issues">
    <input type="text" name="q" placeholder="Search title…" value="<%= filters.q || '' %>">
    <select name="status">
      <option value="">All statuses</option>
      <option value="open"   <%= filters.status==='open'   ? 'selected' : '' %>>Open</option>
      <option value="closed" <%= filters.status==='closed' ? 'selected' : '' %>>Closed</option>
    </select>
    <select name="priority">
      <option value="">All priorities</option>
      <option value="high"   <%= filters.priority==='high'   ? 'selected' : '' %>>High</option>
      <option value="medium" <%= filters.priority==='medium' ? 'selected' : '' %>>Medium</option>
      <option value="low"    <%= filters.priority==='low'    ? 'selected' : '' %>>Low</option>
    </select>
    <select name="repo">
      <option value="">All repos</option>
      <% repos.forEach(r => { %>
        <option value="<%= r %>" <%= filters.repo===r ? 'selected' : '' %>><%= r %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn-sm">Filter</button>
    <a href="/issues" class="btn-sm btn-ghost">Reset</a>
  </form>

  <p class="muted"><%= total %> issue<%= total !== 1 ? 's' : '' %> found</p>

  <table class="data-table">
    <thead><tr><th>Title</th><th>Repo</th><th>Author</th><th>Status</th><th>Priority</th><th>Updated</th></tr></thead>
    <tbody>
    <% rows.forEach(i => { %>
      <tr>
        <td><a href="/issues/<%= i.id %>"><%= i.title %></a></td>
        <td><code><%= i.repo || '—' %></code></td>
        <td><%= i.author || '—' %></td>
        <td><span class="badge status-<%= i.status %>"><%= i.status %></span></td>
        <td><span class="badge priority-<%= i.priority %>"><%= i.priority %></span></td>
        <td class="muted"><%= new Date(i.updated_at).toLocaleDateString() %></td>
      </tr>
    <% }) %>
    <% if (!rows.length) { %>
      <tr><td colspan="6" class="muted" style="text-align:center">No issues match your filters.</td></tr>
    <% } %>
    </tbody>
  </table>

  <% if (pages > 1) { %>
  <div class="pagination">
    <% for (let p = 1; p <= pages; p++) { %>
      <a href="?<%= new URLSearchParams({...filters, page: p}).toString() %>"
         class="<%= p === page ? 'active' : '' %>"><%= p %></a>
    <% } %>
  </div>
  <% } %>
</div>
</body>
</html>