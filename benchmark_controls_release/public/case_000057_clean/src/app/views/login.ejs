<!DOCTYPE html>
<html>
<head>
  <title>Login</title>
  <style>
    body { font-family: Arial; text-align: center; padding: 50px; }
    input { padding: 8px; margin: 5px; }
    button { padding: 8px 20px; background: #007bff; color: white; border: none; cursor: pointer; }
  </style>
</head>
<body>
  <h1>Banking Portal Login</h1>
  <div>
    <input type="text" id="username" placeholder="Username" value="alice">
    <input type="password" id="password" placeholder="Password" value="password123">
    <button onclick="login()">Login</button>
  </div>
  <p>Test users: alice/password123, bob/password456, charlie/password789</p>

  <script>
    function login() {
      const username = document.getElementById('username').value;
      const password = document.getElementById('password').value;
      
      fetch('/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username, password })
      }).then(r => r.json()).then(d => {
        if (d.success) {
          window.location = '/dashboard';
        } else {
          alert('Login failed');
        }
      });
    }
  </script>
</body>
</html>