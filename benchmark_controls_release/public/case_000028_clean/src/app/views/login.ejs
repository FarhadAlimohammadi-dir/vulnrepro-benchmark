<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NeuralOps — Sign In</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-body">
  <div class="auth-card">
    <div class="auth-logo">⬡ NeuralOps</div>
    <h2>Sign In</h2>
    <% if (error) { %>
      <div class="form-error"><%= error %></div>
    <% } %>
    <form method="POST" action="/login" autocomplete="off">
      <label for="username">Username</label>
      <input type="text"     id="username" name="username" required autocomplete="username" placeholder="admin">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required autocomplete="current-password" placeholder="••••••••">
      <button type="submit" class="btn-primary btn-block">Sign In</button>
    </form>
    <p class="auth-note">Contact your administrator to request access.</p>
  </div>
</body>
</html>