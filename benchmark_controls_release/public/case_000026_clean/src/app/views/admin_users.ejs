<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/nav', { user: user, notifications: notifications }) %>
<div class="page-wrapper">
  <div class="page-header">
    <h1>User Management</h1>
    <p class="page-subtitle">Create, view, and manage platform user accounts.</p>
  </div>

  <% if (flash) { %>
  <div class="alert alert-info"><%= flash %></div>
  <% } %>

  <div class="content-grid">
    <div class="content-panel" style="flex:2">
      <div class="panel-header"><h2>All Users</h2></div>
      <table class="data-table">
        <thead>
          <tr><th>Username</th><th>Role</th><th>Email</th><th>Department</th><th>Status</th><th>Actions</th></tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
          <tr>
            <td><strong><%= u.username %></strong></td>
            <td><span class="role-tag role-<%= u.role %>"><%= u.role %></span></td>
            <td class="muted"><%= u.email || '—' %></td>
            <td class="muted"><%= u.department || '—' %></td>
            <td><span class="badge <%= u.active ? 'badge-green' : 'badge-red' %>"><%= u.active ? 'Active' : 'Disabled' %></span></td>
            <td>
              <% if (u.active && u.username !== user.username) { %>
              <form method="POST" action="/admin/users/deactivate" style="display:inline">
                <input type="hidden" name="username" value="<%= u.username %>">
                <button class="btn-danger-sm" type="submit" onclick="return confirm('Deactivate <%= u.username %>?')">Deactivate</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="content-panel" style="flex:1">
      <div class="panel-header"><h2>Create User</h2></div>
      <form method="POST" action="/admin/users/create" class="form-vertical">
        <div class="form-group">
          <label for="new-username">Username *</label>
          <input type="text" id="new-username" name="username" required placeholder="jdoe">
        </div>
        <div class="form-group">
          <label for="new-password">Password *</label>
          <input type="password" id="new-password" name="password" required>
        </div>
        <div class="form-group">
          <label for="new-role">Role *</label>
          <select id="new-role" name="role">
            <option value="readonly">readonly</option>
            <option value="analyst">analyst</option>
            <option value="developer">developer</option>
            <option value="admin">admin</option>
          </select>
        </div>
        <div class="form-group">
          <label for="new-email">Email</label>
          <input type="email" id="new-email" name="email" placeholder="user@company.com">
        </div>
        <div class="form-group">
          <label for="new-dept">Department</label>
          <input type="text" id="new-dept" name="department" placeholder="Engineering">
        </div>
        <button type="submit" class="btn-primary">Create User</button>
      </form>
    </div>
  </div>
</div>
<footer class="footer">
  <span>CloudLens IAM Analyzer &copy; 2024 &mdash; Platform Engineering</span>
  <span class="footer-right">Build 2.0.0-stable</span>
</footer>
</body>
</html>