<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Error — CloudLens' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<% if (typeof user !== 'undefined' && user) { %>
<%- include('partials/nav', { user: user, notifications: [] }) %>
<% } %>
<div class="page-wrapper error-page">
  <div class="error-card">
    <div class="error-code"><%= code || 500 %></div>
    <h1 class="error-title"><%= code === 404 ? 'Page Not Found' : code === 403 ? 'Access Denied' : 'Internal Error' %></h1>
    <p class="error-message"><%= message %></p>
    <a href="/" class="btn-primary">Return to Dashboard</a>
  </div>
</div>
</body>
</html>