<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>AssetFlow - Settings</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <span class="brand">AssetFlow</span>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/audit">Audit Log</a>
      <a href="/logout">Logout</a>
    </div>
    <div class="nav-user">Welcome, <strong><%= username %></strong></div>
  </nav>
  <div class="container">
    <h2>System Settings</h2>
    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="alert alert-success"><%= success %></div>
    <% } %>
    <form method="POST" action="/settings">
      <div class="form-group">
        <label>Data Retention (days)</label>
        <input type="number" name="retention_days" value="<%= config.retention_days %>" min="1" max="3650">
      </div>
      <div class="form-group">
        <label>Max Assets</label>
        <input type="number" name="max_assets" value="<%= config.max_assets %>" min="10" max="100000">
      </div>
      <button type="submit" class="btn btn-primary">Save Settings</button>
    </form>
  </div>
</body>
</html>