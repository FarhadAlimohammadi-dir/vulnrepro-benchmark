<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Users – Admin – DocVault</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="navbar">
  <a class="navbar-brand" href="/docs">📄 DocVault</a>
  <div class="navbar-links">
    <a href="/docs">My Docs</a>
    <a href="/admin" class="active">Admin</a>
    <a href="/logout">Logout</a>
    <span class="navbar-user">👤 <%= user.display_name || user.username %></span>
  </div>
</nav>
<div class="container">
  <div class="page-header">
    <h1>User Management</h1>
    <a href="/admin" class="btn btn-secondary">← Back</a>
  </div>
  <div class="card">
    <table class="table">
      <thead><tr><th>ID</th><th>Username</th><th>Display Name</th><th>Email</th><th>Role</th><th>Joined</th></tr></thead>
      <tbody>
      <% users.forEach(u => { %>
      <tr>
        <td><%= u.id %></td>
        <td><strong><%= u.username %></strong></td>
        <td><%= u.display_name || '—' %></td>
        <td><%= u.email || '—' %></td>
        <td><span class="badge badge-<%= u.role %>"><%= u.role %></span></td>
        <td><%= new Date(u.created_at * 1000).toLocaleDateString() %></td>
      </tr>
      <% }) %>
      </tbody>
    </table>
    <div class="pagination">
      <% for (let i = 1; i <= pages; i++) { %>
        <a href="/admin/users?page=<%= i %>" class="<%= i === page ? 'active' : '' %>"><%= i %></a>
      <% } %>
    </div>
    <p class="pagination-info">Showing <%= users.length %> of <%= total %> users</p>
  </div>
</div>
<footer class="footer"><span>© 2024 DocVault</span></footer>
</body>
</html>