<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Exec Log — NexusRelay</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <nav class="topnav">
    <div class="topnav-brand"><a href="/dashboard" class="brand-link">&#9650; NexusRelay</a></div>
    <div class="topnav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/admin">Admin</a>
    </div>
    <div class="topnav-user">
      <a href="/profile"><%= currentUser %></a> &nbsp;·&nbsp; <a href="/logout">Sign out</a>
    </div>
  </nav>

  <main class="page-content">
    <div class="page-header">
      <a href="/admin" class="breadcrumb">← Admin</a>
      <h1>Execution Log</h1>
    </div>

    <table class="data-table">
      <thead><tr><th>#</th><th>Command</th><th>Output</th><th>Actor</th><th>Exit</th><th>Ran At</th></tr></thead>
      <tbody>
        <% rows.forEach(r => { %>
        <tr>
          <td class="muted small"><%= r.id %></td>
          <td><code class="small"><%= r.command %></code></td>
          <td class="muted small"><%= (r.output || '').slice(0, 80) %></td>
          <td><%= r.actor %></td>
          <td><span class="badge <%= r.exit_code === 0 ? 'badge-green' : 'badge-red' %>"><%= r.exit_code %></span></td>
          <td class="muted small"><%= r.ran_at %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </main>

  <footer class="page-footer"><span>NexusRelay v<%= agentVersion %></span></footer>
</body>
</html>