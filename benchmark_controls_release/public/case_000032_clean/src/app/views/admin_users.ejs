<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>User Management — PixelFlow Admin</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">
      <a href="/">PixelFlow</a>
      <span class="nav-tagline">Analytics Platform</span>
    </div>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/admin">Admin</a>
      <a href="/admin/users" class="active">Users</a>
      <a href="/admin/audit">Audit</a>
      <form action="/logout" method="POST" style="display:inline">
        <button type="submit" class="btn-link">Sign Out</button>
      </form>
    </div>
  </nav>

  <div class="container">
    <div class="page-header">
      <h2>User Management</h2>
    </div>

    <div class="search-bar">
      <form action="/admin/users" method="GET">
        <input type="text" name="q" placeholder="Search by username or email..." value="<%= search %>" class="form-control search-input">
        <button type="submit" class="btn btn-secondary">Search</button>
        <% if (search) { %><a href="/admin/users" class="btn btn-link">Clear</a><% } %>
      </form>
    </div>

    <table class="table">
      <thead>
        <tr><th>Username</th><th>Email</th><th>Role</th><th>Status</th><th>Last Login</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% users.forEach(function(u) { %>
        <tr>
          <td><strong><%= u.username %></strong></td>
          <td class="muted small"><%= u.email || '—' %></td>
          <td><span class="badge"><%= u.role %></span></td>
          <td><span class="badge <%= u.is_active ? 'badge-success' : 'badge-error' %>"><%= u.is_active ? 'Active' : 'Inactive' %></span></td>
          <td class="small muted"><%= u.last_login ? new Date(u.last_login).toLocaleDateString() : 'Never' %></td>
          <td>
            <% if (u.is_active) { %>
              <button class="btn btn-sm btn-danger js-user-action" data-action="deactivate" data-user-id="<%= u.id %>">Deactivate</button>
            <% } else { %>
              <button class="btn btn-sm btn-success js-user-action" data-action="activate" data-user-id="<%= u.id %>">Activate</button>
            <% } %>
          </td>
        </tr>
        <% }); %>
      </tbody>
    </table>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="/admin/users?page=<%= i %><%= search ? '&q=' + encodeURIComponent(search) : '' %>"
             class="page-link <%= page === i ? 'active' : '' %>"><%= i %></a>
        <% } %>
      </div>
    <% } %>
  </div>

  <footer class="footer">
    <p>&copy; 2024 PixelFlow Analytics.</p>
  </footer>

  <script>
  const csrfToken = '<%= csrfToken %>';
  function deactivate(id) {
    if (!confirm('Deactivate this user?')) return;
    fetch('/admin/users/' + id + '/deactivate', {
      method: 'POST',
      credentials: 'include',
      headers: { 'x-csrf-token': csrfToken }
    })
      .then(r => r.json()).then(d => { if (d.success) location.reload(); });
  }
  function activate(id) {
    fetch('/admin/users/' + id + '/activate', {
      method: 'POST',
      credentials: 'include',
      headers: { 'x-csrf-token': csrfToken }
    })
      .then(r => r.json()).then(d => { if (d.success) location.reload(); });
  }
  document.querySelectorAll('.js-user-action').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.dataset.userId;
      if (button.dataset.action === 'deactivate') {
        deactivate(id);
      } else {
        activate(id);
      }
    });
  });
  </script>
</body>
</html>
