<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= statusCode %> — PixelFlow</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand">
      <a href="/">PixelFlow</a>
      <span class="nav-tagline">Analytics Platform</span>
    </div>
    <div class="nav-links">
      <% if (typeof user !== 'undefined' && user) { %>
        <a href="/dashboard">Dashboard</a>
      <% } else { %>
        <a href="/login">Sign In</a>
      <% } %>
    </div>
  </nav>

  <div class="container">
    <div class="error-box">
      <div class="error-icon"><%= statusCode === 404 ? '🔍' : statusCode === 403 ? '🔒' : '⚠️' %></div>
      <h2><%= title %></h2>
      <p class="error-message"><%= message %></p>
      <div class="error-actions">
        <a href="/" class="btn btn-primary">Go Home</a>
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="/dashboard" class="btn btn-secondary">Dashboard</a>
        <% } %>
      </div>
    </div>
  </div>

  <footer class="footer">
    <p>&copy; 2024 PixelFlow Analytics.</p>
  </footer>
</body>
</html>