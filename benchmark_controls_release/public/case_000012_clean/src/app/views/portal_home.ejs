<%- include('layout') %>
<% const title = 'Portal' %>

<div class="page-header"><h1>Integration Portal</h1></div>

<p>The NexusBoard portal provides access to external integrations, SSO click-through handling, and workspace resource directories.</p>

<% if (unread > 0) { %>
