<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>NexusBoard — <%= typeof title !== 'undefined' ? title : 'Error' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="auth-page">
<div class="auth-card" style="text-align:center">
  <div class="auth-logo">NexusBoard</div>
  <h2><%= typeof title !== 'undefined' ? title : 'Error' %></h2>
  <p><%= message %></p>
  <a href="/dashboard" class="btn btn-primary">Go to Dashboard</a>
</div>
</body>
</html>