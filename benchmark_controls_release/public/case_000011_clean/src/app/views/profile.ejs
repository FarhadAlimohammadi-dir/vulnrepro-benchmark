<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Profile – CodeNest</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <a class="brand" href="/">🪐 CodeNest</a>
  <div class="nav-links">
    <a href="/">Snippets</a>
    <a href="/snippets/new">New</a>
    <% if (role === 'admin') { %><a href="/admin">Admin</a><% } %>
    <a href="/profile">Profile</a>
    <span class="sep">|</span>
    <span class="nav-user">👤 <%= username %></span>
    <a href="/logout">Sign out</a>
  </div>
</nav>
<% if (flash) { %>
<div class="flash flash-<%= flash.type %>"><%- flash.msg %></div>
<% } %>
<main class="container">
  <h1>Your Profile</h1>

  <% if (errors && errors.length > 0) { %>
  <div class="flash flash-error">
    <ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
  </div>
  <% } %>

  <div class="profile-grid">
    <div class="profile-card">
      <div class="avatar-lg" style="background:<%= user.avatar_color %>"><%= user.username[0].toUpperCase() %></div>
      <h2><%= user.username %></h2>
      <span class="badge"><%= user.role %></span>
      <p class="text-muted">Member since <%= user.created_at ? user.created_at.slice(0,10) : '' %></p>
      <p><%= user.bio || '' %></p>
    </div>

    <div>
      <section class="section">
        <h2>Edit Profile</h2>
        <form method="POST" action="/profile" class="form-card">
          <div class="form-group">
            <label>Email</label>
            <input name="email" type="email" value="<%= user.email || '' %>">
          </div>
          <div class="form-group">
            <label>Bio</label>
            <textarea name="bio" rows="3"><%= user.bio || '' %></textarea>
          </div>
          <div class="form-group">
            <label>Avatar Color</label>
            <input name="avatar_color" type="color" value="<%= user.avatar_color || '#4f46e5' %>">
          </div>
          <button type="submit" class="btn btn-primary">Save Changes</button>
        </form>
      </section>

      <section class="section">
        <h2>Your Recent Snippets</h2>
        <% if (mySnips.length === 0) { %>
          <p class="text-muted">You haven't created any snippets yet.</p>
        <% } else { %>
        <table class="data-table">
          <thead><tr><th>Title</th><th>Language</th><th>Created</th></tr></thead>
          <tbody>
          <% mySnips.forEach(s => { %>
            <tr>
              <td><a href="/snippets/<%= s.id %>"><%= s.title %></a></td>
              <td><span class="badge badge-lang"><%= s.language %></span></td>
              <td class="text-muted"><%= s.created_at ? s.created_at.slice(0,10) : '' %></td>
            </tr>
          <% }) %>
          </tbody>
        </table>
        <% } %>
      </section>
    </div>
  </div>
</main>
<footer><span>CodeNest v2.0 &nbsp;·&nbsp; <a href="/health">Status</a></span></footer>
</body>
</html>