<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin – CodeNest</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <a class="brand" href="/">🪐 CodeNest</a>
  <div class="nav-links">
    <a href="/">Snippets</a>
    <a href="/snippets/new">New</a>
    <a href="/admin">Admin</a>
    <a href="/profile">Profile</a>
    <span class="sep">|</span>
    <span class="nav-user">👤 <%= username %></span>
    <a href="/logout">Sign out</a>
  </div>
</nav>
<% if (flash) { %>
<div class="flash flash-<%= flash.type %>"><%- flash.msg %></div>
<% } %>
<main class="container">
  <h1>Administration</h1>

  <div class="stats-row">
    <div class="stat-card"><div class="stat-num"><%= users.length %></div><div>Users</div></div>
    <div class="stat-card"><div class="stat-num"><%= snippetCount %></div><div>Snippets</div></div>
    <div class="stat-card"><div class="stat-num"><%= auditData.total %></div><div>Audit Events</div></div>
  </div>

  <section class="section">
    <h2>Users</h2>
    <table class="data-table">
      <thead><tr><th>Username</th><th>Email</th><th>Role</th><th>Joined</th><th>Action</th></tr></thead>
      <tbody>
      <% users.forEach(u => { %>
        <tr>
          <td><a href="/users/<%= u.username %>"><%= u.username %></a></td>
          <td><%= u.email || '—' %></td>
          <td><span class="badge"><%= u.role %></span></td>
          <td class="text-muted"><%= u.created_at ? u.created_at.slice(0,10) : '' %></td>
          <td>
            <form method="POST" action="/admin/users/<%= u.id %>/role" style="display:inline">
              <select name="role" onchange="this.form.submit()">
                <option value="member" <%= u.role === 'member' ? 'selected' : '' %>>member</option>
                <option value="admin"  <%= u.role === 'admin'  ? 'selected' : '' %>>admin</option>
              </select>
            </form>
          </td>
        </tr>
      <% }) %>
      </tbody>
    </table>
  </section>

  <section class="section">
    <h2>Audit Log</h2>
    <table class="data-table">
      <thead><tr><th>Time</th><th>User</th><th>Action</th><th>Resource</th><th>IP</th></tr></thead>
      <tbody>
      <% auditData.rows.forEach(e => { %>
        <tr>
          <td class="text-muted"><%= e.created_at %></td>
          <td><%= e.username || '(anon)' %></td>
          <td><code><%= e.action %></code></td>
          <td><%= e.resource_type || '' %> <%= e.resource_id || '' %></td>
          <td class="text-muted"><%= e.ip || '' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    <% if (auditData.pages > 1) { %>
    <div class="pagination">
      <% for (let i = 1; i <= auditData.pages; i++) { %>
        <a href="/admin?page=<%= i %>" class="btn btn-sm <%= i === auditData.page ? 'btn-primary' : 'btn-ghost' %>"><%= i %></a>
      <% } %>
    </div>
    <% } %>
  </section>
</main>
<footer><span>CodeNest v2.0 &nbsp;·&nbsp; <a href="/health">Status</a></span></footer>
</body>
</html>