<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> – CodeNest</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <a class="brand" href="/">🪐 CodeNest</a>
  <div class="nav-links">
    <a href="/">Snippets</a>
    <a href="/snippets/new">New</a>
    <% if (role === 'admin') { %><a href="/admin">Admin</a><% } %>
    <a href="/profile">Profile</a>
    <span class="sep">|</span>
    <span class="nav-user">👤 <%= username %></span>
    <a href="/logout">Sign out</a>
  </div>
</nav>
<main class="container">
  <div class="breadcrumb"><a href="/">Snippets</a> / <%= title %></div>
  <h1><%= title %></h1>

  <% if (errors && errors.length > 0) { %>
  <div class="flash flash-error">
    <ul><% errors.forEach(e => { %><li><%= e %></li><% }) %></ul>
  </div>
  <% } %>

  <form method="POST" action="<%= action %>" class="form-card">
    <div class="form-group">
      <label>Title *</label>
      <input name="title" type="text" value="<%= snippet && snippet.title ? snippet.title : '' %>" required maxlength="200">
    </div>
    <div class="form-group">
      <label>Description</label>
      <input name="description" type="text" value="<%= snippet && snippet.description ? snippet.description : '' %>" maxlength="500">
    </div>
    <div class="form-group">
      <label>Language</label>
      <select name="language">
        <% ['text','javascript','typescript','python','bash','sql','css','html','json','yaml','go','rust'].forEach(l => { %>
          <option value="<%= l %>" <%= snippet && snippet.language === l ? 'selected' : '' %>><%= l %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group">
      <label>Content *</label>
      <textarea name="content" rows="16" required><%= snippet && snippet.content ? snippet.content : '' %></textarea>
    </div>
    <div class="form-actions">
      <button type="submit" class="btn btn-primary">Save Snippet</button>
      <a href="/" class="btn btn-ghost">Cancel</a>
    </div>
  </form>
</main>
<footer><span>CodeNest v2.0 &nbsp;·&nbsp; <a href="/health">Status</a></span></footer>
</body>
</html>