<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' – CodeNest' : 'CodeNest' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="topnav">
    <a class="brand" href="/">🪐 CodeNest</a>
    <div class="nav-links">
      <a href="/">Snippets</a>
      <a href="/snippets/new">New</a>
      <% if (typeof role !== 'undefined' && role === 'admin') { %>
        <a href="/admin">Admin</a>
      <% } %>
      <a href="/profile">Profile</a>
      <span class="sep">|</span>
      <span class="nav-user">👤 <%= username %></span>
      <a href="/logout">Sign out</a>
    </div>
  </nav>
  <% if (typeof flash !== 'undefined' && flash) { %>
  <div class="flash flash-<%= flash.type %>"><%- flash.msg %></div>
  <% } %>
  <main>
    <%- body %>
  </main>
  <footer>
    <span>CodeNest v2.0 &nbsp;·&nbsp; <a href="/health">Status</a></span>
  </footer>
</body>
</html>