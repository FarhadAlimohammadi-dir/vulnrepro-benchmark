<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Nexus Identity' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<% if (typeof user !== 'undefined' && user) { %>
<nav class="navbar">
  <div class="nav-brand"><a href="/">&#9679; Nexus</a></div>
  <div class="nav-links">
    <a href="/dashboard">Dashboard</a>
    <a href="/profile">Profile</a>
    <a href="/settings">Settings</a>
    <% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %>
  </div>
  <div class="nav-user">
    <span class="nav-email"><%= user.email %></span>
    <form action="/logout" method="POST" style="display:inline">
      <button type="submit" class="btn-link">Sign out</button>
    </form>
  </div>
</nav>
<% } else { %>
<nav class="navbar navbar-public">
  <div class="nav-brand"><a href="/">&#9679; Nexus</a></div>
  <div class="nav-links">
    <a href="/auth/login">Sign In</a>
    <a href="/auth/register" class="btn-primary-small">Get Started</a>
  </div>
</nav>
<% } %>
<main class="main-content">