<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Settings — NexusRelay</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <nav class="topnav">
    <div class="topnav-brand"><a href="/dashboard" class="brand-link">&#9650; NexusRelay</a></div>
    <div class="topnav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/workflows">Workflows</a>
      <a href="/workspace/load">Workspace</a>
      <a href="/workspace/settings" class="active">Settings</a>
    </div>
    <div class="topnav-user">
      <a href="/profile"><%= currentUser %></a> &nbsp;·&nbsp; <a href="/logout">Sign out</a>
    </div>
  </nav>

  <main class="page-content">
    <div class="page-header"><h1>Settings</h1></div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <div class="two-col">
      <section>
        <h2>Gateway</h2>
        <div class="info-block">
          <div class="info-row"><span>Endpoint</span><code class="small"><%= gateway.gatewayUrl %></code></div>
          <div class="info-row"><span>Status</span>
            <span class="badge <%= gateway.connected ? 'badge-green' : 'badge-red' %>">
              <%= gateway.connected ? 'Connected' : 'Disconnected' %>
            </span>
          </div>
          <div class="info-row"><span>Sandbox Mode</span><%= gateway.sandboxMode ? 'Enabled' : 'Disabled' %></div>
          <div class="info-row"><span>Exec Approvals</span><%= gateway.execApprovalsEnabled ? 'Required' : 'Skipped' %></div>
        </div>
        <p class="muted small">Gateway endpoint is managed by your operator configuration. Contact your admin to change it.</p>
      </section>

      <section>
        <h2>Webhooks</h2>
        <form method="POST" action="/workspace/settings">
          <div class="form-group">
            <label>Endpoint URL</label>
            <input type="url" name="webhookUrl" placeholder="https://hooks.example.com/nr" />
          </div>
          <div class="form-group">
            <label>Events (comma-separated)</label>
            <input type="text" name="events" placeholder="workflow.complete, exec.done" />
          </div>
          <button type="submit" class="btn btn-primary">Add Webhook</button>
        </form>

        <% if (webhooks.length > 0) { %>
        <table class="data-table mt16">
          <thead><tr><th>URL</th><th>Active</th><th>Added</th></tr></thead>
          <tbody>
            <% webhooks.forEach(wh => { %>
            <tr>
              <td class="small"><%= wh.url %></td>
              <td><span class="status-dot <%= wh.active ? 'green' : 'grey' %>"></span></td>
              <td class="muted small"><%= wh.created_at %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } %>
      </section>
    </div>
  </main>

  <footer class="page-footer"><span>NexusRelay v<%= agentVersion %></span></footer>
</body>
</html>