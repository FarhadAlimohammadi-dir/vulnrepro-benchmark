<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Audit Log — NexusRelay</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <nav class="topnav">
    <div class="topnav-brand"><a href="/dashboard" class="brand-link">&#9650; NexusRelay</a></div>
    <div class="topnav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/admin">Admin</a>
    </div>
    <div class="topnav-user">
      <a href="/profile"><%= currentUser %></a> &nbsp;·&nbsp; <a href="/logout">Sign out</a>
    </div>
  </nav>

  <main class="page-content">
    <div class="page-header">
      <a href="/admin" class="breadcrumb">← Admin</a>
      <h1>Audit Log</h1>
    </div>

    <table class="data-table">
      <thead><tr><th>#</th><th>Actor</th><th>Action</th><th>Target</th><th>IP</th><th>Time</th></tr></thead>
      <tbody>
        <% rows.forEach(r => { %>
        <tr>
          <td class="muted small"><%= r.id %></td>
          <td><strong><%= r.actor %></strong></td>
          <td><span class="badge"><%= r.action %></span></td>
          <td class="muted small"><%= r.target %></td>
          <td class="muted small"><%= r.ip %></td>
          <td class="muted small"><%= r.created_at %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>

    <div class="pagination">
      <% if (page > 1) { %><a href="/admin/audit?page=<%= page-1 %>" class="btn btn-ghost">← Prev</a><% } %>
      <span class="muted">Page <%= page %> of <%= pages %> (<%= total %> total)</span>
      <% if (page < pages) { %><a href="/admin/audit?page=<%= page+1 %>" class="btn btn-ghost">Next →</a><% } %>
    </div>
  </main>

  <footer class="page-footer"><span>NexusRelay v<%= agentVersion %></span></footer>
</body>
</html>