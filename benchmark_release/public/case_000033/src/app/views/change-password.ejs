<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Change Password - Accounts Center</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <div class="logo">Accounts Center</div>
      <ul class="nav-menu">
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/account/overview">Account</a></li>
        <li><a href="/account/security" class="active">Security</a></li>
        <li class="user-menu">
          <span><%= typeof user !== 'undefined' ? user.first_name || user.username : '' %></span>
          <a href="/auth/logout" class="btn-logout">Logout</a>
        </li>
      </ul>
    </div>
  </nav>

  <div class="container">
    <h1>Change Password</h1>
    
    <div class="auth-box">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-error"><%= error %></div>
      <% } %>
      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success"><%= success %></div>
      <% } %>
      
      <form method="POST" action="/account/password">
        <div class="form-group">
          <label for="current_password">Current Password</label>
          <input type="password" id="current_password" name="current_password" required>
        </div>
        
        <div class="form-group">
          <label for="new_password">New Password</label>
          <input type="password" id="new_password" name="new_password" required>
        </div>
        
        <div class="form-group">
          <label for="confirm_password">Confirm New Password</label>
          <input type="password" id="confirm_password" name="confirm_password" required>
        </div>
        
        <button type="submit" class="btn btn-primary">Update Password</button>
      </form>
    </div>
  </div>
</body>
</html>