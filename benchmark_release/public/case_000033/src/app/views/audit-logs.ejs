<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Activity Logs - Accounts Center</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="container">
      <div class="logo">Accounts Center</div>
      <ul class="nav-menu">
        <li><a href="/dashboard">Dashboard</a></li>
        <li><a href="/account/overview">Account</a></li>
        <li><a href="/billing_interfaces">Billing</a></li>
        <li><a href="/audit/logs" class="active">Activity</a></li>
        <li class="user-menu">
          <span><%= user.first_name || user.username %></span>
          <a href="/auth/logout" class="btn-logout">Logout</a>
        </li>
      </ul>
    </div>
  </nav>

  <div class="container">
    <h1>Activity Logs</h1>
    
    <section class="card">
      <% if (logs && logs.length > 0) { %>
        <table class="logs-table">
          <thead>
            <tr>
              <th>Action</th>
              <th>Date</th>
              <th>IP Address</th>
              <th>Details</th>
            </tr>
          </thead>
          <tbody>
            <% logs.forEach(log => { %>
              <tr>
                <td><strong><%= log.action %></strong></td>
                <td><%= new Date(log.created_at).toLocaleString() %></td>
                <td><%= log.ip_address || 'N/A' %></td>
                <td><%= log.details || 'N/A' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
        
        <% if (totalPages > 1) { %>
          <div class="pagination">
            <% for (let i = 1; i <= totalPages; i++) { %>
              <% if (i === page) { %>
                <span class="current"><%= i %></span>
              <% } else { %>
                <a href="/audit/logs?page=<%= i %>"><%= i %></a>
              <% } %>
            <% } %>
          </div>
        <% } %>
      <% } else { %>
        <p>No activity logs</p>
      <% } %>
    </section>
  </div>
</body>
</html>