<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>DevForge – <%= project.name %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/dashboard">⚙ DevForge</a>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/projects">Projects</a>
      <% if (currentUser && currentUser.role === 'admin') { %><a href="/admin">Admin</a><% } %>
      <a href="/profile">👤 <%= currentUser ? currentUser.username : '' %></a>
      <a href="/logout">Logout</a>
    </div>
  </nav>
  <main class="container">
    <div class="page-header">
      <div>
        <h1><%= project.name %></h1>
        <p class="muted"><%= project.description || 'No description provided.' %></p>
      </div>
      <div>
        <a href="/projects/<%= project.id %>/edit" class="btn">Edit</a>
        <span class="badge"><%= project.lang %></span>
      </div>
    </div>

    <div class="section">
      <div style="display:flex;justify-content:space-between;align-items:center">
        <h2>Snippets</h2>
        <a href="/projects/<%= project.id %>/snippets/new" class="btn btn-sm btn-primary">+ Add Snippet</a>
      </div>
      <% if (snippets.length === 0) { %>
        <p class="muted">No snippets yet.</p>
      <% } else { %>
      <% snippets.forEach(s => { %>
      <div class="snippet-card">
        <div class="snippet-header">
          <strong><%= s.title %></strong>
          <span class="badge"><%= s.lang %></span>
          <span class="muted" style="font-size:.8rem">by <%= s.author_name %></span>
        </div>
        <pre class="code-block"><%= s.body %></pre>
      </div>
      <% }) %>
      <% } %>
    </div>

    <div class="section">
      <h2>Task Runner</h2>
      <div class="task-runner">
        <input type="text" id="cmd-input" placeholder="ls -la" class="cmd-input">
        <button class="btn btn-primary" onclick="runTask()">▶ Run</button>
      </div>
      <pre id="task-output" class="code-output">—</pre>
    </div>

    <div class="section">
      <h2>Task Logs</h2>
      <div id="task-logs"><button class="btn btn-sm" onclick="loadLogs()">Load Logs</button></div>
    </div>
  </main>
  <footer class="footer">DevForge v2.0 &copy; 2024</footer>
  <script>
    const PROJECT_ID = <%= project.id %>;
    async function runTask() {
      const cmd = document.getElementById('cmd-input').value.trim();
      if (!cmd) return;
      document.getElementById('task-output').textContent = 'Running…';
      const r = await fetch('/api/tasks/run', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({ command: cmd, project_id: PROJECT_ID })
      });
      const d = await r.json();
      document.getElementById('task-output').textContent = d.stdout || d.error || JSON.stringify(d, null, 2);
    }

    async function loadLogs() {
      const r = await fetch(`/api/tasks/logs?project_id=${PROJECT_ID}`);
      const d = await r.json();
      const el = document.getElementById('task-logs');
      if (!d.logs || d.logs.length === 0) { el.innerHTML = '<p class="muted">No logs.</p>'; return; }
      el.innerHTML = '<table class="data-table"><thead><tr><th>Command</th><th>Status</th><th>When</th></tr></thead><tbody>' +
        d.logs.map(l => `<tr><td><code>${l.command}</code></td><td><span class="badge badge-${l.status}">${l.status}</span></td><td class="muted">${l.created_at}</td></tr>`).join('') +
        '</tbody></table>';
    }
  </script>
</body>
</html>