<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>DevForge – Error <%= code %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <a class="brand" href="/dashboard">⚙ DevForge</a>
    <% if (currentUser) { %>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/logout">Logout</a>
    </div>
    <% } %>
  </nav>
  <main class="container" style="text-align:center;padding-top:4rem">
    <h1 style="font-size:5rem;margin:0;color:#4f46e5"><%= code %></h1>
    <p style="font-size:1.2rem;color:#555"><%= message %></p>
    <a href="/dashboard" class="btn btn-primary" style="margin-top:1.5rem">Back to Dashboard</a>
  </main>
  <footer class="footer">DevForge v2.0 &copy; 2024</footer>
</body>
</html>