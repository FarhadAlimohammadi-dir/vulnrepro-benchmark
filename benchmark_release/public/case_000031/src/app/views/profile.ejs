<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>Profile — SocialKit</title>
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<header class="site-header">
  <div class="container">
    <a class="logo" href="/">SocialKit</a>
    <nav class="main-nav">
      <a href="/dashboard">Dashboard</a>
      <a href="/profile" class="active">Profile</a>
      <a href="/settings/widgets">Widgets</a>
      <a href="/logout" class="nav-logout">Sign out</a>
    </nav>
  </div>
</header>
<main class="main-content">
<div class="container">
  <div class="form-card">
    <h2>My Profile</h2>
    <% if (saved) { %><div class="alert alert-success">Profile saved successfully.</div><% } %>

    <div class="profile-info">
      <p><strong>Username:</strong> <%= user.username %></p>
      <p><strong>Email:</strong> <%= user.email || '—' %></p>
      <p><strong>Role:</strong> <span class="badge badge-<%= user.role %>"><%= user.role %></span></p>
      <p><strong>Member since:</strong> <%= new Date(user.created_at).toLocaleDateString() %></p>
      <% if (user.last_login) { %><p><strong>Last login:</strong> <%= new Date(user.last_login).toLocaleString() %></p><% } %>
    </div>

    <form method="POST" action="/profile">
      <div class="form-group">
        <label for="bio">Bio</label>
        <textarea id="bio" name="bio" rows="4" placeholder="Tell us about yourself"><%= user.bio || '' %></textarea>
      </div>
      <div class="form-group">
        <label for="avatar_url">Avatar URL</label>
        <input type="url" id="avatar_url" name="avatar_url" value="<%= user.avatar_url || '' %>" placeholder="https://example.com/avatar.png">
      </div>
      <button type="submit" class="btn btn-primary">Save Profile</button>
    </form>
  </div>
</div>
</main>
<footer class="site-footer"><div class="container"><p>&copy; 2024 SocialKit Platform</p></div></footer>
</body>
</html>