<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ToolBridge – Connecting to <%= providerName %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <div class="nav-brand"><a href="/dashboard">ToolBridge</a></div>
  </nav>
  <main class="main-content">
    <div class="oauth-page">
      <div class="oauth-card">
        <div class="oauth-spinner">&#9696;</div>
        <h2>Connecting to <%= providerName %></h2>
        <p class="muted">An authorization window is opening. Please complete the login in the popup.</p>
        <p id="status-msg" class="muted small">Preparing authorization URL…</p>
        <div class="oauth-actions">
          <button id="btn-retry" class="btn btn-primary" style="display:none">Open Window Again</button>
          <a href="/integrations" class="btn btn-ghost">Cancel</a>
        </div>
      </div>
    </div>
  </main>
  <script>
  (function () {
    var authUrl = "<%- authUrl %>";
    var providerName = "<%- providerName %>";
    var statusEl = document.getElementById('status-msg');
    var retryBtn = document.getElementById('btn-retry');

    function openAuthWindow(url) {
      statusEl.textContent = 'Redirecting to: ' + url;
      // Opens the provider authorization page for the OAuth flow
      var popup = window.open(url, 'tb_oauth_window', 'width=640,height=740,noopener=0');
      if (!popup) {
        statusEl.textContent = 'Popup was blocked. Click the button below to try again.';
        retryBtn.style.display = 'inline-block';
      }
    }

    retryBtn.addEventListener('click', function () {
      openAuthWindow(authUrl);
    });

    openAuthWindow(authUrl);
  })();
  </script>
  <footer class="site-footer"><p>&copy; 2024 ToolBridge, Inc.</p></footer>
</body>
</html>