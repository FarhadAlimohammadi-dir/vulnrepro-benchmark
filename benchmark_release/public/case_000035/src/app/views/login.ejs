<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/main.css" />
</head>
<body class="auth-page">
  <div class="auth-container">
    <div class="auth-logo">
      <a href="/">&#9656; Gateway Portal</a>
    </div>
    <div class="auth-card">
      <h2>Employee Sign In</h2>
      <p class="auth-subtitle">Use your corporate email address</p>
      <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
      <% } %>
      <form action="/login" method="POST" class="auth-form">
        <div class="form-group">
          <label for="username">Corporate Email</label>
          <input type="email" id="username" name="username" placeholder="you@target.com" required autofocus />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Your password" required />
        </div>
        <button type="submit" class="btn btn-primary btn-full">Sign In</button>
      </form>
      <div class="auth-footer">
        <p>Don't have an account? <a href="/register">Register here</a></p>
      </div>
    </div>
  </div>
</body>
</html>