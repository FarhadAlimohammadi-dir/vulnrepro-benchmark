<%- include('partials/header', { title: title }) %>
<div class="page-header">
  <h1>Settings</h1>
</div>

<% if (flash) { %>
<div class="alert alert-<%= flash.type %>"><%= flash.message %></div>
<% } %>

<div class="settings-grid">
  <section class="card" id="password">
    <h2>Change Password</h2>
    <form action="/settings/password" method="POST">
      <div class="form-group">
        <label for="current_password">Current Password</label>
        <input type="password" id="current_password" name="current_password" class="input" required>
      </div>
      <div class="form-group">
        <label for="new_password">New Password</label>
        <input type="password" id="new_password" name="new_password" class="input" required minlength="8">
      </div>
      <div class="form-group">
        <label for="confirm_password">Confirm New Password</label>
        <input type="password" id="confirm_password" name="confirm_password" class="input" required>
      </div>
      <button type="submit" class="btn-primary">Update Password</button>
    </form>
  </section>

  <section class="card" id="api-keys">
    <h2>API Keys</h2>
    <p class="muted">Use API keys to authenticate programmatic access to Nexus APIs.</p>
    <form action="/api/v1/keys" method="POST" class="inline-form">
      <input type="text" name="name" placeholder="Key name (e.g. CI/CD)" class="input" required>
      <select name="expires_in_days" class="input-select">
        <option value="">Never</option>
        <option value="30">30 days</option>
        <option value="90">90 days</option>
        <option value="365">1 year</option>
      </select>
      <button type="submit" class="btn-secondary">Generate Key</button>
    </form>
  </section>

  <section class="card" id="sessions">
    <h2>Active Sessions</h2>
    <p class="muted">You are currently signed in. To sign out of all sessions, use the button below.</p>
    <form action="/logout" method="POST">
      <button type="submit" class="btn-danger">Sign Out All Sessions</button>
    </form>
  </section>
</div>
<%- include('partials/footer') %>