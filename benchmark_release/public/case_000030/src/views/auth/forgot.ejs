<%- include('../partials/header', { title: title, user: null }) %>
<div class="auth-container">
  <div class="auth-card">
    <h1>Reset your password</h1>
    <% if (typeof sent !== 'undefined' && sent) { %>
    <div class="alert alert-success">If an account exists for that email, we've sent password reset instructions.</div>
    <a href="/auth/login" class="btn-secondary btn-full">Back to Sign In</a>
    <% } else { %>
    <% if (typeof error !== 'undefined' && error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form action="/auth/forgot-password" method="POST" class="auth-form">
      <div class="form-group">
        <label for="email">Email address</label>
        <input type="email" id="email" name="email" class="input" required placeholder="you@example.com">
      </div>
      <button type="submit" class="btn-primary btn-full">Send Reset Link</button>
    </form>
    <p class="auth-footer"><a href="/auth/login">Back to Sign In</a></p>
    <% } %>
  </div>
</div>
<%- include('../partials/footer') %>