<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>AssetFlow - Profile</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <nav class="navbar">
    <span class="brand">AssetFlow</span>
    <div class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/logout">Logout</a>
    </div>
    <div class="nav-user">Welcome, <strong><%= username %></strong></div>
  </nav>
  <div class="container">
    <h2>User Profile</h2>
    <div class="detail-card">
      <table class="detail-table">
        <tr><th>Username</th><td><%= username %></td></tr>
        <tr><th>Role</th><td><%= roleLabel %></td></tr>
      </table>
    </div>
    <!-- TODO: support self-service password change (AUTH-2210) -->
    <a href="/dashboard" class="btn btn-secondary">Back to Dashboard</a>
  </div>
</body>
</html>