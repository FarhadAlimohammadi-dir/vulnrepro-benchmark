<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="site-header">
    <div class="container">
      <h1 class="logo">💛 Cerca</h1>
      <nav>
        <a href="/api-docs">API Docs</a>
        <a href="/health">Health</a>
      </nav>
    </div>
  </header>

  <main class="hero">
    <div class="container">
      <h2>Find your person.</h2>
      <p class="tagline">Cerca connects you with verified singles nearby.</p>
      <div class="cta-group">
        <a class="btn btn-primary" href="#">Download the app</a>
        <a class="btn btn-secondary" href="/api-docs">View API</a>
      </div>
    </div>
  </main>

  <section class="features">
    <div class="container">
      <div class="feature-card">
        <span class="icon">🔒</span>
        <h3>Verified Profiles</h3>
        <p>Every profile is reviewed against a government-issued ID before going live.</p>
      </div>
      <div class="feature-card">
        <span class="icon">📍</span>
        <h3>Nearby Matches</h3>
        <p>Discover people within your preferred distance using precise location matching.</p>
      </div>
      <div class="feature-card">
        <span class="icon">💬</span>
        <h3>Mutual Matching</h3>
        <p>Chat only opens when both people have expressed interest — no unwanted messages.</p>
      </div>
    </div>
  </section>

  <footer>
    <div class="container">
      <p>&copy; 2024 Cerca Inc. All rights reserved.</p>
    </div>
  </footer>
</body>
</html>