<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NexusBoard — <%= typeof title !== 'undefined' ? title : 'Workspace' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="navbar">
  <div class="nav-brand"><a href="/dashboard">NexusBoard</a></div>
  <div class="nav-links">
    <% if (currentUser) { %>
      <a href="/dashboard">Dashboard</a>
      <a href="/projects">Projects</a>
      <a href="/portal/links">Resources</a>
      <a href="/portal/profile">Profile</a>
      <% if (currentRole === 'admin') { %><a href="/admin">Admin</a><% } %>
      <a href="/logout">Sign out (<%= currentUser %>)</a>
    <% } else { %>
      <a href="/login">Sign in</a>
    <% } %>
  </div>
</nav>
<% if (flash) { %>
<div class="flash"><%= flash %></div>
<% } %>
<main class="container">