<%
  title = ws.name
  const projRows = projects.map(p => `
    <tr>
      <td><a href="/projects/${p.id}">${p.name}</a></td>
      <td class="muted">${p.description || ''}</td>
      <td><span class="pill">${p.language || '—'}</span></td>
      <td class="muted">${p.owner_name}</td>
      <td>
        <form action="/projects/${p.id}/archive" method="post" style="display:inline">
          <button class="danger" style="font-size:0.8rem;padding:0.2rem 0.5rem">Archive</button>
        </form>
      </td>
    </tr>
  `).join('')

  const memberRows = members.map(m => `
    <tr>
      <td>${m.username}</td>
      <td class="muted">${m.email}</td>
      <td><span class="pill">${m.role}</span></td>
    </tr>
  `).join('')

  body = `
<h1>${ws.name} <span class="pill">${ws.visibility}</span></h1>
<p class="muted">${ws.description || 'No description'}</p>

<details style="margin-bottom:1rem">
  <summary>Edit workspace</summary>
  <form class="form" method="post" action="/workspaces/${ws.id}/update" style="margin-top:0.5rem">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:0.5rem;align-items:end">
      <label>Name<input name="name" value="${ws.name}" required></label>
      <label>Description<input name="description" value="${ws.description || ''}"></label>
      <label>Visibility
        <select name="visibility">
          <option value="private" ${ws.visibility==='private'?'selected':''}>Private</option>
          <option value="team"    ${ws.visibility==='team'?'selected':''}>Team</option>
          <option value="public"  ${ws.visibility==='public'?'selected':''}>Public</option>
        </select>
      </label>
      <div><button type="submit">Save</button></div>
    </div>
  </form>
</details>

<h2>Projects</h2>
<form class="form" method="post" action="/projects" style="background:#fff;padding:1rem;border-radius:6px;margin-bottom:1rem">
  <input type="hidden" name="workspace_id" value="${ws.id}">
  <div style="display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:0.5rem;align-items:end">
    <label>Name<input name="name" required></label>
    <label>Description<input name="description"></label>
    <label>Language<input name="language" placeholder="js, py, rs…"></label>
    <div><button type="submit">Add project</button></div>
  </div>
</form>
<table class="list">
  <thead><tr><th>Name</th><th>Description</th><th>Lang</th><th>Owner</th><th></th></tr></thead>
  <tbody>${projRows || '<tr><td colspan="5" class="muted">No projects yet</td></tr>'}</tbody>
</table>

<h2>Members</h2>
<form class="form" method="post" action="/workspaces/${ws.id}/invite" style="display:flex;gap:0.5rem;margin-bottom:1rem;align-items:end">
  <label>Email<input name="email" type="email" placeholder="colleague@example.com"></label>
  <label>Role
    <select name="role"><option value="developer">Developer</option><option value="viewer">Viewer</option></select>
  </label>
  <div style="align-self:flex-end"><button type="submit">Invite</button></div>
</form>
<table class="list">
  <thead><tr><th>Username</th><th>Email</th><th>Role</th></tr></thead>
  <tbody>${memberRows || '<tr><td colspan="3" class="muted">No members yet</td></tr>'}</tbody>
</table>
`
%>
<%- include('layout', { title, body, user, flash }) %>