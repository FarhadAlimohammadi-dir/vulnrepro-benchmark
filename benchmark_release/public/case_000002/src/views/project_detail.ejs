<%
  title = proj.name
  const fileRows = files.map(f => `
    <tr>
      <td><a href="/projects/${proj.id}/files/${f.id}" target="_blank">${f.path}</a></td>
      <td class="muted">${(f.size/1024).toFixed(1)} KB</td>
      <td>
        <form action="/projects/${proj.id}/files/${f.id}/delete" method="post" style="display:inline">
          <button class="danger" style="font-size:0.8rem;padding:0.2rem 0.5rem">Delete</button>
        </form>
      </td>
    </tr>
  `).join('')

  body = `
<h1>${proj.name}
  <span class="pill">${proj.language || '—'}</span>
  ${proj.archived ? '<span class="pill" style="background:#fef3c7">archived</span>' : ''}
</h1>
<p class="muted">${proj.description || 'No description'} · workspace: <a href="/workspaces/${proj.workspace_id}">${proj.workspace_name}</a></p>

${hasSettings ? '<div class="flash flash-info">✔ <code>.claspace/settings.json</code> present — automations active</div>' : ''}

<div class="actions" style="margin:1rem 0">
  <button onclick="openProject(${proj.id})">▶ Open project</button>
  <button onclick="formatProject(${proj.id})">✦ Format</button>
</div>
<pre id="actionLog" class="log" style="min-height:2rem"></pre>

<h2>Files</h2>
<form method="post" action="/projects/${proj.id}/files" enctype="multipart/form-data"
      style="background:#fff;padding:1rem;border-radius:6px;margin-bottom:1rem;display:flex;gap:0.5rem;align-items:flex-end">
  <label>Path (e.g. <code>.claspace/settings.json</code>)
    <input name="path" placeholder=".claspace/settings.json" style="width:22rem">
  </label>
  <label>File <input type="file" name="file" required></label>
  <div><button type="submit">Upload</button></div>
</form>
<table class="list">
  <thead><tr><th>Path</th><th>Size</th><th></th></tr></thead>
  <tbody>${fileRows || '<tr><td colspan="3" class="muted">No files uploaded</td></tr>'}</tbody>
</table>

<details style="margin-top:1.5rem">
  <summary>Edit project metadata</summary>
  <form class="form" method="post" action="/projects/${proj.id}/update" style="margin-top:0.5rem">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:0.5rem;align-items:end">
      <label>Name<input name="name" value="${proj.name}" required></label>
      <label>Description<input name="description" value="${proj.description || ''}"></label>
      <label>Language<input name="language" value="${proj.language || ''}"></label>
      <div><button type="submit">Save</button></div>
    </div>
  </form>
</details>
`
%>
<%- include('layout', { title, body, user, flash }) %>