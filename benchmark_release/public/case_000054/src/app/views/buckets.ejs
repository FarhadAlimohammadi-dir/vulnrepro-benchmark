<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CloudVault — Buckets</title>
  <link rel="stylesheet" href="/css/main.css">
</head>
<body>
  <header class="site-header">
    <div class="container">
      <a href="/dashboard" class="logo">☁ CloudVault</a>
      <nav class="main-nav">
        <a href="/dashboard">Dashboard</a>
        <a href="/buckets" class="active">Buckets</a>
        <a href="/search">Search</a>
        <% if (currentUser && currentUser.role === 'admin') { %>
          <a href="/admin">Admin</a>
        <% } %>
        <a href="/profile">Profile</a>
        <form method="POST" action="/logout" style="display:inline">
          <button type="submit" class="btn-link">Sign Out</button>
        </form>
      </nav>
    </div>
  </header>
  <main class="container">
    <div class="page-header">
      <h1>Buckets</h1>
      <% if (currentUser && currentUser.role === 'admin') { %>
        <button class="btn btn-primary" onclick="document.getElementById('create-modal').style.display='flex'">+ Create Bucket</button>
      <% } %>
    </div>

    <table class="data-table">
      <thead>
        <tr>
          <th>Bucket Name</th>
          <th>Region</th>
          <th>Created</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% buckets.forEach(b => { %>
          <tr>
            <td><a href="/buckets/<%= b.id %>"><%= b.name %></a></td>
            <td><span class="badge"><%= b.region %></span></td>
            <td><%= new Date(b.createdAt).toLocaleDateString() %></td>
            <td>
              <a href="/buckets/<%= b.id %>" class="btn btn-small">View</a>
              <% if (currentUser && currentUser.role === 'admin') { %>
                <form method="POST" action="/buckets/<%= b.id %>/delete" style="display:inline" onsubmit="return confirm('Delete bucket <%= b.name %>?')">
                  <button type="submit" class="btn btn-small btn-danger">Delete</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
        <% if (buckets.length === 0) { %>
          <tr><td colspan="4" class="empty">No buckets found.</td></tr>
        <% } %>
      </tbody>
    </table>

    <% if (totalPages > 1) { %>
      <div class="pagination">
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="/buckets?page=<%= i %>" class="<%= i === page ? 'active' : '' %>"><%= i %></a>
        <% } %>
      </div>
    <% } %>

    <div id="create-modal" class="modal" style="display:none">
      <div class="modal-content">
        <h2>Create Bucket</h2>
        <form method="POST" action="/buckets/create">
          <div class="form-group">
            <label>Bucket Name</label>
            <input type="text" name="name" required placeholder="my-bucket-name" pattern="[a-z0-9][a-z0-9\-]{2,61}[a-z0-9]">
            <small>4-63 characters, lowercase letters, numbers, and hyphens only</small>
          </div>
          <div class="form-group">
            <label>Region</label>
            <select name="region">
              <option value="us-east-1">US East (N. Virginia)</option>
              <option value="us-west-2">US West (Oregon)</option>
              <option value="eu-west-1">EU (Ireland)</option>
              <option value="ap-southeast-1">Asia Pacific (Singapore)</option>
            </select>
          </div>
          <div class="form-actions">
            <button type="button" class="btn" onclick="document.getElementById('create-modal').style.display='none'">Cancel</button>
            <button type="submit" class="btn btn-primary">Create</button>
          </div>
        </form>
      </div>
    </div>
  </main>
  <footer class="site-footer">
    <div class="container">
      <span>CloudVault Storage Manager v2.1.0</span>
    </div>
  </footer>
</body>
</html>