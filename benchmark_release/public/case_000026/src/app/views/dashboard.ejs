<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<%- include('partials/nav', { user: user, notifications: notifications }) %>
<div class="page-wrapper">
  <div class="page-header">
    <h1>Dashboard</h1>
    <p class="page-subtitle">Welcome back, <strong><%= user.username %></strong>. Here is your IAM access overview.</p>
  </div>

  <div class="stats-row">
    <div class="stat-card">
      <div class="stat-value"><%= policyCount %></div>
      <div class="stat-label">Attached Policies</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= accessibleArns.length %></div>
      <div class="stat-label">Accessible Resources</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= user.role %></div>
      <div class="stat-label">Account Role</div>
    </div>
    <div class="stat-card">
      <div class="stat-value"><%= notifications.length %></div>
      <div class="stat-label">Unread Notifications</div>
    </div>
  </div>

  <div class="content-grid">
    <div class="content-panel">
      <div class="panel-header">
        <h2>Your IAM Policies</h2>
        <span class="badge badge-blue"><%= policies.length %> policies</span>
      </div>
      <% if (policies.length === 0) { %>
      <p class="empty-state">No policies are currently attached to your account.</p>
      <% } else { %>
      <table class="data-table">
        <thead>
          <tr>
            <th>Policy Name</th>
            <th>Created By</th>
            <th>Attached At</th>
            <th>Document</th>
          </tr>
        </thead>
        <tbody>
          <% policies.forEach(p => { %>
          <tr>
            <td><code class="mono"><%= p.policy_name || 'inline-policy' %></code></td>
            <td><span class="user-chip-sm"><%= p.created_by || 'system' %></span></td>
            <td class="muted"><%= p.created_at %></td>
            <td><details><summary>View</summary><pre class="policy-pre"><%= p.policy_json %></pre></details></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>

    <div class="content-panel">
      <div class="panel-header">
        <h2>Resource Access</h2>
        <a href="/resources" class="btn-link">View all &rarr;</a>
      </div>
      <table class="data-table">
        <thead>
          <tr><th>Resource</th><th>Sensitivity</th><th>Access</th></tr>
        </thead>
        <tbody>
          <% allResources.forEach(r => { %>
          <tr>
            <td><code class="mono small"><%= r.arn %></code><br><span class="muted"><%= r.label %></span></td>
            <td><span class="badge badge-sensitivity-<%= r.sensitivity %>"><%= r.sensitivity %></span></td>
            <td>
              <% if (accessibleArns.includes(r.arn)) { %>
              <span class="badge badge-green">Allowed</span>
              <% } else { %>
              <span class="badge badge-red">Denied</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>

  <% if (recentActivity.length > 0) { %>
  <div class="content-panel mt-1">
    <div class="panel-header">
      <h2>Recent Activity</h2>
      <a href="/profile" class="btn-link">Full history &rarr;</a>
    </div>
    <table class="data-table">
      <thead><tr><th>Action</th><th>Detail</th><th>Time</th></tr></thead>
      <tbody>
        <% recentActivity.forEach(e => { %>
        <tr>
          <td><code class="mono small"><%= e.action %></code></td>
          <td class="muted"><%= e.detail || '—' %></td>
          <td class="muted"><%= e.ts %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<footer class="footer">
  <span>CloudLens IAM Analyzer &copy; 2024 &mdash; Platform Engineering</span>
  <span class="footer-right">Build 2.0.0-stable</span>
</footer>
</body>
</html>