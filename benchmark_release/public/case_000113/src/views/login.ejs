<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>CollabDocs — Sign In</title>
  <style>
    body { font-family: system-ui, sans-serif; background: #f0f2f5; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
    .card { background: #fff; padding: 2rem; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,.1); width: 360px; }
    h1 { margin: 0 0 1.5rem; font-size: 1.5rem; color: #1a1a2e; }
    label { display: block; margin-bottom: .25rem; font-size: .875rem; color: #555; }
    input { width: 100%; padding: .6rem; border: 1px solid #ccc; border-radius: 4px; margin-bottom: 1rem; box-sizing: border-box; }
    button { width: 100%; padding: .7rem; background: #0066cc; color: #fff; border: none; border-radius: 4px; cursor: pointer; font-size: 1rem; }
    button:hover { background: #0055aa; }
    .error { color: #c0392b; font-size: .875rem; margin-bottom: 1rem; }
  </style>
</head>
<body>
  <div class="card">
    <h1>CollabDocs</h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form method="POST" action="/auth/login">
      <label for="username">Username</label>
      <input type="text" id="username" name="username" autocomplete="username" required>
      <label for="password">Password</label>
      <input type="password" id="password" name="password" autocomplete="current-password" required>
      <button type="submit">Sign In</button>
    </form>
  </div>
  <script>
    const form = document.querySelector('form');
    form.addEventListener('submit', async e => {
      e.preventDefault();
      const fd = new FormData(form);
      const resp = await fetch('/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ username: fd.get('username'), password: fd.get('password') })
      });
      const data = await resp.json();
      if (data.ok) {
        window.location.href = '/dashboard';
      } else {
        document.querySelector('.error')?.remove();
        const p = document.createElement('p');
        p.className = 'error';
        p.textContent = data.error;
        form.prepend(p);
      }
    });
  </script>
</body>
</html>