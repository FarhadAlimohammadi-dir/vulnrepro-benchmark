<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>CollabDocs — Search</title>
  <style>
    body { font-family: system-ui, sans-serif; margin: 0; background: #f7f8fc; }
    nav { background: #1a1a2e; color: #fff; padding: .75rem 2rem; }
    nav a { color: #8ab4f8; text-decoration: none; margin-left: 1rem; }
    .container { max-width: 700px; margin: 2rem auto; padding: 0 1rem; }
    input[type=text] { width: 70%; padding: .6rem; border: 1px solid #ccc; border-radius: 4px; }
    button { padding: .6rem 1.2rem; background: #0066cc; color: #fff; border: none; border-radius: 4px; cursor: pointer; }
    .result { background: #fff; border-radius: 6px; padding: 1rem; margin-bottom: .75rem; box-shadow: 0 1px 4px rgba(0,0,0,.07); }
    .result h3 { margin: 0 0 .25rem; }
    .meta { font-size: .75rem; color: #888; }
  </style>
</head>
<body>
  <nav><strong><a href="/dashboard" style="color:#fff;text-decoration:none;">CollabDocs</a></strong></nav>
  <div class="container">
    <h2>Search Documents</h2>
    <form method="GET" action="/search" style="margin-bottom:1.5rem;">
      <input type="text" name="q" value="<%= query %>" placeholder="Search...">
      <button type="submit">Search</button>
    </form>
    <% if (results.length === 0 && query) { %>
      <p>No results for "<%= query %>".</p>
    <% } %>
    <% results.forEach(r => { %>
    <div class="result">
      <h3><%= r.title %></h3>
      <p class="meta">by <%= r.author %> &bull; <%= new Date(r.created_at).toLocaleDateString() %></p>
    </div>
    <% }) %>
  </div>
</body>
</html>