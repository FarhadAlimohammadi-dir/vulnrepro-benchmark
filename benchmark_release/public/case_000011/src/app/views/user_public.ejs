<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= user.username %> – CodeNest</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <a class="brand" href="/">🪐 CodeNest</a>
  <div class="nav-links">
    <a href="/">Snippets</a>
    <a href="/snippets/new">New</a>
    <% if (role === 'admin') { %><a href="/admin">Admin</a><% } %>
    <a href="/profile">Profile</a>
    <span class="sep">|</span>
    <span class="nav-user">👤 <%= username %></span>
    <a href="/logout">Sign out</a>
  </div>
</nav>
<main class="container">
  <div class="profile-card-inline">
    <div class="avatar-lg" style="background:<%= user.avatar_color %>"><%= user.username[0].toUpperCase() %></div>
    <div>
      <h1><%= user.username %></h1>
      <span class="badge"><%= user.role %></span>
      <p><%= user.bio || '' %></p>
      <p class="text-muted">Member since <%= user.created_at ? user.created_at.slice(0,10) : '' %></p>
    </div>
  </div>

  <section class="section">
    <h2>Snippets by <%= user.username %></h2>
    <% if (snips.length === 0) { %>
      <p class="text-muted">No public snippets yet.</p>
    <% } else { %>
    <table class="data-table">
      <thead><tr><th>Title</th><th>Language</th><th>Description</th><th>Created</th></tr></thead>
      <tbody>
      <% snips.forEach(s => { %>
        <tr>
          <td><a href="/snippets/<%= s.id %>"><%= s.title %></a></td>
          <td><span class="badge badge-lang"><%= s.language %></span></td>
          <td class="text-muted"><%= s.description ? s.description.slice(0,80) : '' %></td>
          <td class="text-muted"><%= s.created_at ? s.created_at.slice(0,10) : '' %></td>
        </tr>
      <% }) %>
      </tbody>
    </table>
    <% } %>
  </section>
</main>
<footer><span>CodeNest v2.0 &nbsp;·&nbsp; <a href="/health">Status</a></span></footer>
</body>
</html>