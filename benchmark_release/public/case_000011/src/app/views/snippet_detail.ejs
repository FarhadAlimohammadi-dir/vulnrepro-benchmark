<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= snippet.title %> – CodeNest</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<nav class="topnav">
  <a class="brand" href="/">🪐 CodeNest</a>
  <div class="nav-links">
    <a href="/">Snippets</a>
    <a href="/snippets/new">New</a>
    <% if (role === 'admin') { %><a href="/admin">Admin</a><% } %>
    <a href="/profile">Profile</a>
    <span class="sep">|</span>
    <span class="nav-user">👤 <%= username %></span>
    <a href="/logout">Sign out</a>
  </div>
</nav>
<% if (flash) { %>
<div class="flash flash-<%= flash.type %>"><%- flash.msg %></div>
<% } %>
<main class="container">
  <div class="breadcrumb"><a href="/">Snippets</a> / <%= snippet.title %></div>

  <div class="snippet-header">
    <div>
      <h1><%= snippet.title %></h1>
      <p class="text-muted"><%= snippet.description || '' %></p>
    </div>
    <div class="snippet-actions">
      <span class="badge badge-lang"><%= snippet.language %></span>
      <a href="/users/<%= snippet.username %>" class="btn btn-ghost btn-sm">👤 <%= snippet.username %></a>
      <a href="/snippets/<%= snippet.id %>/edit" class="btn btn-sm">Edit</a>
      <form method="POST" action="/snippets/<%= snippet.id %>/delete" style="display:inline" onsubmit="return confirm('Delete this snippet?')">
        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
      </form>
    </div>
  </div>

  <pre class="code-block"><code><%= snippet.content %></code></pre>

  <div class="meta-row text-muted">
    Created: <%= snippet.created_at %> &nbsp;·&nbsp; Updated: <%= snippet.updated_at %>
  </div>

  <% if (history.length > 0) { %>
  <section class="section">
    <h2>Revision History</h2>
    <table class="data-table">
      <thead><tr><th>#</th><th>Summary</th><th>Date</th></tr></thead>
      <tbody>
      <% history.forEach(h => { %>
        <tr><td>v<%= h.version %></td><td><%= h.summary %></td><td class="text-muted"><%= h.created_at %></td></tr>
      <% }) %>
      </tbody>
    </table>
  </section>
  <% } %>

  <section class="section">
    <h2>Comments (<%= comments.length %>)</h2>
    <% if (comments.length === 0) { %>
      <p class="text-muted">No comments yet.</p>
    <% } %>
    <% comments.forEach(c => { %>
    <div class="comment-card">
      <div class="comment-meta">
        <a href="/users/<%= c.username %>">
          <span class="avatar" style="background:<%= c.avatar_color %>"><%= c.username[0].toUpperCase() %></span>
          <%= c.username %>
        </a>
        <span class="text-muted"><%= c.created_at %></span>
      </div>
      <div class="comment-body"><%= c.body %></div>
    </div>
    <% }) %>
    <form method="POST" action="/snippets/<%= snippet.id %>/comment" class="comment-form">
      <textarea name="body" rows="3" placeholder="Leave a comment…" required></textarea>
      <button type="submit" class="btn btn-primary">Post Comment</button>
    </form>
  </section>
</main>
<footer><span>CodeNest v2.0 &nbsp;·&nbsp; <a href="/health">Status</a></span></footer>
</body>
</html>