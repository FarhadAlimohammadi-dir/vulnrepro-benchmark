<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= project.name %> - ProjectHub</title>
  <style>
    body { font-family: sans-serif; background: #f5f6fa; margin: 0; }
    .navbar { background: #2c3e50; color: white; padding: 12px 24px; display: flex; gap: 16px; align-items: center; }
    .navbar a { color: #ecf0f1; text-decoration: none; font-size: 14px; }
    .brand { font-size: 18px; font-weight: bold; }
    .container { max-width: 800px; margin: 40px auto; padding: 0 20px; }
    .card { background: white; border-radius: 8px; box-shadow: 0 1px 4px rgba(0,0,0,0.1); padding: 24px; margin-bottom: 20px; }
    .badge { font-size: 12px; background: #eaf4fb; color: #2980b9; padding: 3px 10px; border-radius: 12px; }
    .feedback-item { border-bottom: 1px solid #eee; padding: 12px 0; }
    .feedback-item:last-child { border-bottom: none; }
  </style>
</head>
<body>
  <nav class="navbar">
    <span class="brand"><a href="/" style="color:white;">ProjectHub</a></span>
    <a href="/projects">Projects</a>
    <a href="/search">Search</a>
    <% if (currentUser) { %>
      <a href="/dashboard">Dashboard</a>
    <% } else { %>
      <a href="/auth/login">Login</a>
    <% } %>
  </nav>
  <div class="container">
    <div class="card">
      <h1 style="margin:0 0 8px;"><%= project.name %></h1>
      <span class="badge"><%= project.status %></span>
      <span style="color:#aaa;font-size:13px;margin-left:8px;">by <%= project.owner_name %></span>
      <p style="margin-top:16px;color:#555;"><%= project.description %></p>
      <p style="color:#aaa;font-size:12px;">Tags: <%= project.tags %></p>
    </div>
    <div class="card">
      <h3>Feedback (<%= feedback.length %>)</h3>
      <% feedback.forEach(f => { %>
        <div class="feedback-item">
          <strong><%= f.username %></strong>
          <span style="color:#f39c12;margin-left:8px;"><%= '★'.repeat(f.rating) %></span>
          <p style="margin:4px 0;color:#555;font-size:14px;"><%= f.content %></p>
        </div>
      <% }) %>
      <% if (!feedback.length) { %><p style="color:#aaa;">No feedback yet.</p><% } %>
    </div>
  </div>
</body>
</html>