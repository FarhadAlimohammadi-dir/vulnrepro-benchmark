<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NeuralOps — <%- title %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <header class="topbar">
    <div class="topbar-brand">
      <span class="logo">⬡ NeuralOps</span>
    </div>
    <nav class="topbar-nav">
      <% if (currentUser) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/runs">Runs</a>
        <a href="/analytics/summary" id="nav-analytics" style="display:none">Analytics</a>
        <% if (currentRole === 'admin') { %>
          <a href="/admin">Admin</a>
        <% } %>
        <a href="/profile">Profile</a>
        <form method="POST" action="/logout" style="display:inline">
          <button type="submit" class="btn-link">Sign out (<%= currentUser %>)</button>
        </form>
      <% } else { %>
        <a href="/login">Sign in</a>
      <% } %>
    </nav>
  </header>
  <main class="page-content">
    <% if (flash) { %>
      <div class="flash-msg"><%= flash %></div>
    <% } %>
    <%- body %>
  </main>
  <footer class="page-footer">
    <span>NeuralOps Platform &copy; 2025</span>
  </footer>
</body>
</html>