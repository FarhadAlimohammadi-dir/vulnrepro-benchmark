<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — NoteVault' : 'NoteVault' %></title>
  <link rel="stylesheet" href="/_assets/static/app.css">
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">NoteVault</a>
    <nav class="main-nav">
      <% if (user) { %>
        <a href="/dashboard">Dashboard</a>
        <a href="/notes">Notes</a>
        <a href="/search">Search</a>
        <% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %>
        <a href="/profile" class="nav-username"><%= user.display_name || user.username %></a>
        <form action="/logout" method="post" style="margin:0">
          <button type="submit" class="btn btn-sm btn-outline">Sign out</button>
        </form>
      <% } else { %>
        <a href="/login" class="btn btn-sm">Sign in</a>
      <% } %>
    </nav>
  </div>
</header>
<main class="container main-content">
  <%- body %>
</main>
<footer class="site-footer">
  <div class="container">
    <small>&copy; 2024 NoteVault, Inc. &mdash; <a href="/api/stats/usage">Platform stats</a></small>
  </div>
</footer>
</body>
</html>