<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — NoteVault</title>
  <link rel="stylesheet" href="/_assets/static/app.css">
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">NoteVault</a>
    <nav class="main-nav">
      <a href="/dashboard">Dashboard</a>
      <a href="/notes">Notes</a>
      <a href="/search">Search</a>
      <% if (user.role === 'admin') { %><a href="/admin">Admin</a><% } %>
      <a href="/profile" class="nav-username"><%= user.display_name || user.username %></a>
      <form action="/logout" method="post" style="margin:0">
        <button type="submit" class="btn btn-sm btn-outline">Sign out</button>
      </form>
    </nav>
  </div>
</header>
<main class="container main-content">
  <% if (flash) { %><div class="alert alert-success"><%= flash %></div><% } %>
  <div class="page-header">
    <h2>Dashboard</h2>
    <a href="/notes/new" class="btn btn-sm">+ New note</a>
  </div>

  <% if (workspaces && workspaces.length) { %>
  <section class="mb-lg">
    <h3 class="section-title">Your Workspaces</h3>
    <div class="ws-grid">
      <% workspaces.forEach(ws => { %>
      <a href="/workspace/<%= ws.slug %>" class="ws-card"><%= ws.name %></a>
      <% }) %>
    </div>
  </section>
  <% } %>

  <section>
    <h3 class="section-title">Recent Notes</h3>
    <% if (notes.length === 0) { %>
      <p class="empty-state">No notes yet. <a href="/notes/new">Create your first note</a>.</p>
    <% } else { %>
    <table class="data-table">
      <thead><tr><th>Title</th><th>Last updated</th><th></th></tr></thead>
      <tbody>
        <% notes.forEach(n => { %>
        <tr>
          <td><a href="/notes/<%= n.id %>"><%= n.title %></a> <% if (n.pinned) { %><span class="badge">pinned</span><% } %></td>
          <td><%= n.updated_at %></td>
          <td><a href="/notes/<%= n.id %>/edit" class="link-muted">edit</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <p class="mt-sm"><a href="/notes">View all notes →</a></p>
    <% } %>
  </section>
</main>
<footer class="site-footer"><div class="container"><small>&copy; 2024 NoteVault, Inc.</small></div></footer>
</body>
</html>