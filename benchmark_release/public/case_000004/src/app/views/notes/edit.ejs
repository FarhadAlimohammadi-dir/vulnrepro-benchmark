<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= note ? 'Edit note' : 'New note' %> — NoteVault</title>
  <link rel="stylesheet" href="/_assets/static/app.css">
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">NoteVault</a>
    <nav class="main-nav">
      <a href="/dashboard">Dashboard</a>
      <a href="/notes">Notes</a>
      <a href="/search">Search</a>
      <a href="/profile" class="nav-username"><%= user.display_name || user.username %></a>
      <form action="/logout" method="post" style="margin:0">
        <button type="submit" class="btn btn-sm btn-outline">Sign out</button>
      </form>
    </nav>
  </div>
</header>
<main class="container main-content">
  <div class="page-header">
    <h2><%= note ? 'Edit note' : 'New note' %></h2>
    <a href="/notes" class="btn btn-sm btn-outline">← Back</a>
  </div>

  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

  <form method="post" action="<%= note ? '/notes/' + note.id + '/edit' : '/notes' %>" class="card form-stack">
    <div class="form-group">
      <label for="title">Title</label>
      <input id="title" name="title" type="text" value="<%= note ? note.title : '' %>" required placeholder="Note title…">
    </div>
    <div class="form-group">
      <label for="body">Content</label>
      <textarea id="body" name="body" rows="14" placeholder="Write your note here… (Markdown supported)"><%= note ? note.body : '' %></textarea>
    </div>
    <div class="form-group">
      <label for="workspace_id">Workspace (optional)</label>
      <select id="workspace_id" name="workspace_id">
        <option value="">— Personal (no workspace) —</option>
        <% workspaces.forEach(ws => { %>
        <option value="<%= ws.id %>" <%= (note && note.workspace_id === ws.id) ? 'selected' : '' %>><%= ws.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="form-group form-check">
      <label><input type="checkbox" name="pinned" <%= (note && note.pinned) ? 'checked' : '' %>> Pin this note to the top</label>
    </div>
    <div style="display:flex;gap:8px">
      <button type="submit" class="btn">Save note</button>
      <a href="<%= note ? '/notes/' + note.id : '/notes' %>" class="btn btn-outline">Cancel</a>
    </div>
  </form>
</main>
<footer class="site-footer"><div class="container"><small>&copy; 2024 NoteVault, Inc.</small></div></footer>
</body>
</html>