<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Notes — NoteVault</title>
  <link rel="stylesheet" href="/_assets/static/app.css">
</head>
<body>
<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo">NoteVault</a>
    <nav class="main-nav">
      <a href="/dashboard">Dashboard</a>
      <a href="/notes">Notes</a>
      <a href="/search">Search</a>
      <a href="/profile" class="nav-username"><%= user.display_name || user.username %></a>
      <form action="/logout" method="post" style="margin:0">
        <button type="submit" class="btn btn-sm btn-outline">Sign out</button>
      </form>
    </nav>
  </div>
</header>
<main class="container main-content">
  <div class="page-header">
    <h2>My Notes</h2>
    <a href="/notes/new" class="btn btn-sm">+ New note</a>
  </div>

  <% if (notes.length === 0) { %>
    <p class="empty-state">No notes yet. <a href="/notes/new">Create your first note</a>.</p>
  <% } else { %>
  <table class="data-table">
    <thead><tr><th>Title</th><th>Last updated</th><th></th></tr></thead>
    <tbody>
      <% notes.forEach(n => { %>
      <tr>
        <td>
          <a href="/notes/<%= n.id %>"><%= n.title %></a>
          <% if (n.pinned) { %><span class="badge">pinned</span><% } %>
        </td>
        <td><%= n.updated_at %></td>
        <td>
          <a href="/notes/<%= n.id %>/edit" class="link-muted">edit</a>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <% if (totalPages > 1) { %>
  <div class="pagination">
    <% if (page > 1) { %><a href="/notes?page=<%= page-1 %>" class="btn btn-sm btn-outline">← Previous</a><% } %>
    <span class="page-info">Page <%= page %> of <%= totalPages %></span>
    <% if (page < totalPages) { %><a href="/notes?page=<%= page+1 %>" class="btn btn-sm btn-outline">Next →</a><% } %>
  </div>
  <% } %>
  <% } %>
</main>
<footer class="site-footer"><div class="container"><small>&copy; 2024 NoteVault, Inc.</small></div></footer>
</body>
</html>